# Multi-Agent System Overview (Paste into https://play.d2lang.com)
direction: down

vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 1
  }
}

control: "Prozesssteuerung & Sicherheits-Schranken" {
  style.fill: "#f8fafc"
  style.stroke: "#cbd5e1"
  queue: "Auftrags-Warteschlange\nGeordnete Fallübergabe" { style.fill: "#ffffff"; style.stroke: "#334155" }
  loader: "Schadensart-Vorbereitung\nLädt Checkliste & Arbeitsanweisung" { style.fill: "#ffffff"; style.stroke: "#334155" }
  orchestrator: "Zentraler Claims Orchestrator (Microsoft Foundry)\nKoordiniert alle Prüfschritte, schützt vor Manipulation & pausiert Vorgänge bei Rückfragen" { style.fill: "#f8fafc"; style.stroke: "#0284c7"; style.bold: true }
  breaker: "Sicherheits-Schranke & Sachbearbeiter-Übergabe\nKeine automatische Ablehnung (DSGVO Art. 22) | Übergabe bei Großschäden & Betrugsverdacht" { style.fill: "#ffffff"; style.stroke: "#334155" }
  queue -> loader -> orchestrator
  orchestrator <-> breaker
}

agents: "Fünf spezialisierte KI-Agenten mit streng getrennten Zugriffsrechten" {
  style.fill: "#ffffff"
  style.stroke: "#0284c7"
  a1: "1. Kundenkommunikation\n• Prüft Vollständigkeit der Belege\n• Erstellt Abrechnungsschreiben\n• Interne Qualitätskontrolle vor Versand" { style.fill: "#f8fafc"; style.stroke: "#334155" }
  a2: "2. Deckungsprüfung\n• Prüft Vertrag & Selbstbehalt\n• Gleicht exakt mit den damals\n  gültigen Bedingungen (AVB) ab" { style.fill: "#f8fafc"; style.stroke: "#334155" }
  a3: "3. Betrugs- & Risikoprüfung\n• Prüft Fotos auf Dubletten\n• Erkennt organisierte Betrugsnetze\n  über Azure Databricks" { style.fill: "#f8fafc"; style.stroke: "#334155" }
  a4: "4. Rechnungs- & Tarifprüfung\n• Ordnet Rechnungspositionen zu\n• Interne Gebühren-Kontrolle\n• Ruft deterministische Rechen-Engine" { style.fill: "#f8fafc"; style.stroke: "#334155" }
  a5: "5. Auszahlung & Buchung\n• Bucht Schadenrückstellungen\n• Stößt SEPA-Auszahlung bei\n  eindeutiger Freigabe an" { style.fill: "#f8fafc"; style.stroke: "#334155" }
}

backends: "Verbindliche Kernsysteme & Wissensquellen" {
  style.fill: "#f1f5f9"
  style.stroke: "#1e293b"
  b1: "Schadenakte & Datenschutz-Tresor\nZuordnung der Empfängerdaten\nerst beim finalen Versand" { style.fill: "#ffffff"; style.stroke: "#334155" }
  b2: "Historisches Bedingungswerk\nSuche in exakt der vertraglich\nvereinbarten Tarifgeneration" { style.fill: "#ffffff"; style.stroke: "#334155" }
  b3: "Azure Databricks Analyseplattform\nAbgleich mit Betrugsnetzwerken\n& historischen Schadenmustern" { style.fill: "#ffffff"; style.stroke: "#334155" }
  b4: "Deterministische Rechen-Engine\nVerbindliche Berechnung von\nHöchstgrenzen & Abzügen" { style.fill: "#ffffff"; style.stroke: "#334155" }
  b5: "Bestands- & Zahlungssystem (SAP)\nVertragsdaten, Rückstellungen\n& SEPA-Banküberweisung" { style.fill: "#ffffff"; style.stroke: "#334155" }
}

control.orchestrator -> agents.a1 -> backends.b1
control.orchestrator -> agents.a2 -> backends.b2
control.orchestrator -> agents.a3 -> backends.b3
control.orchestrator -> agents.a4 -> backends.b4
control.orchestrator -> agents.a5 -> backends.b5
