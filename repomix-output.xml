      // 4. Vector Store (Azure AI Search & Foundry IQ)
      vector_search = store 'Azure AI Search & Foundry IQ: policy-knowledge' {
        #versioning #private_endpoint
        summary 'Integrated Vectorization Indexer, Hybrid Search (BM25 + HNSW), RRF & L2 Semantic Reranker'
        icon bootstrap:search
        description '''
          ### Enterprise RAG & Foundry IQ Knowledge Base (`policy-knowledge`)
          Kombiniert **Integrated Vectorization**, **strikte AVB-Versionsfilterung** und **mehrstufiges Reranking**:
          1. **Indexer & Skillset Pipeline (`search_indexer`):**
             - **Document Intelligence Layout Skill:** Zerlegt juristische AVB-PDFs und Tarif-Tabellen strukturтреu nach Paragraphen (`§`) und Markdown-Tabellen (kein Zerschneiden von Tabellenzeilen).
             - **Text Split Skill:** Semantisches Chunking (`~800-1000` Tokens, `150` Tokens Overlap) unter Vererbung von `avbVersionId`, `productLine` und `clauseCode`.
             - **Azure OpenAI Embedding Skill:** Erzeugt Vektoren via `text-embedding-3-large` (3.072 Dimensionen) über Shared Private Link.
          2. **Stage 1 Retrieval — Pre-Filtered Hybrid Search (`table_vector_index`):**
             - **Harter OData Pre-Filter:** `avbVersionId eq '<ContractBoundVersion>' and productLine eq '<ClaimType>'`.
             - **BM25 Keyword Search:** Findet exakte Paragraphen (`§ 12 Abs. 2 AKB`), Tarifcodes und juristische Fachbegriffe.
             - **HNSW Vector Search:** Findet semantische Äquivalenzen (Cosine Similarity).
          3. **Stage 2 & 3 — RRF Fusion & L2 Semantic Reranker (`semantic_reranker`):**
             - **Reciprocal Rank Fusion (RRF)** kombiniert Top-50 BM25 + Top-50 Vektor-Treffer.
             - **L2 Cross-Encoder Semantic Ranker** berechnet `@search.rerankerScore (0.0 - 4.0)` (Cutoff `< 2.2`) und liefert Extractive Captions für rechtssichere EOB-Zitate.
        '''

        search_indexer = compute '1. Integrated Vectorization Indexer & Layout Skillset' {
          #versioning
          summary 'ContentUnderstandingSkill (Semantic Token Chunking), text-embedding-3-large & Index Projections'
          icon bootstrap:gear-wide
          metadata {
            skillset 'ContentUnderstandingSkill (method: semantic, unit: tokens, max: 500) + AzureOpenAIEmbeddingSkill'
            projection_mode 'skipIndexingParentDocuments (one-to-many child chunk projection)'
            execution_environment 'private (Shared Private Link to blob storage & Azure OpenAI)'
            change_detection 'HighWaterMarkChangeDetectionPolicy + Native Blob Soft Delete'
          }
        }

        table_vector_index = schema_entity '2. Hybrid Index: policy-knowledge-idx (BM25 + HNSW SQ8)' {
          #schema_def #versioning
          summary 'Speichert AVB-Generationen: HNSW (m:4, ef:400) mit Int8-Quantisierung, Rescoring, stored:false & Index Alias'
          description '''
            ### Index: `policy-knowledge-idx` (Aktiver Alias: `policy-knowledge-active`)
            | Feld | Typ | Attribute / Optimierung |
            | :--- | :--- | :--- |
            | **chunkId** | `String [Key]` | Eindeutiger Hash-Schlüssel des Chunks (`analyzer: keyword`) |
            | **parentDocId** | `String [Filter]` | Referenz auf das Ursprungs-AVB-Dokument im Blob Storage |
            | **avbVersionId** | `String [Filter]` | **Strikter OData Pre-Filter** (`AVB-KFZ-2021-V1`, `AVB-KFZ-2026-V2`) |
            | **docCategory** | `String [Filter]` | `CONTRACTUAL_AVB`, `TARIFF_TABLE`, `REPAIR_GUIDELINE` |
            | **productLine** | `String [Filter, Facet]`| Sparte (`AUTO_GLASS`, `WATER_DAMAGE`, `BODILY_INJURY`) |
            | **clauseCode** | `String [Filter, Facet]`| Exakte Klausel-Referenz (`§ 12 Abs. 2 AKB`, `Ziff. 4.1`) |
            | **clauseText** | `String [Search, Retrievable]` | Deutscher Fließtext (`analyzer: de.microsoft`, Lemmatisierung & Komposita) |
            | **embedding** | `Collection(Edm.Single)` | `text-embedding-3-large` (3.072 Dims, `stored: false`, `searchable: true`) |
            | **sensitivityLabel**| `String [Filter]` | Microsoft Purview Schutzlabel (`purviewEnabled: true`) |

            ### Vektor-Komprimierung & Speicher-Optimierung:
            - **Algorithmus:** HNSW (`m: 4`, `efConstruction: 400`, `efSearch: 500`, `metric: cosine`).
            - **Scalar Quantization (SQ8):** Komprimiert Float32-Embeddings auf `int8` (4-fache RAM-Reduktion).
            - **Rescoring & Oversampling:** `enableRescoring: true`, `defaultOversampling: 10`, `rescoreStorageMethod: preserveOriginals`.
            - **Zero-Downtime Migration:** Produktions-Agenten adressieren den Index-Alias `policy-knowledge-active`.
          '''
        }

        semantic_reranker = ai_service '3. L2 Semantic Ranker & Foundry IQ Agentic Retrieval' {
          #versioning
          summary 'Pre-Filtered Hybrid RRF (maxTextRecallSize: 1000), Cross-Encoder L2 Reranker, Captions & Query Rewrites'
          icon bootstrap:funnel
          metadata {
            vector_filter_mode 'preFilter (strikter OData-Filter vor/während HNSW-Traversierung)'
            hybrid_ranking 'Reciprocal Rank Fusion (RRF k=60, maxTextRecallSize=1000, countRetrievableResults)'
            semantic_l2 'Cross-Encoder Reranker (@search.rerankerScore >= 2.2 Cutoff, max 2048 tokens context)'
            query_rewriting 'generative|count-5 (queryLanguage: de-DE, Synonyme & Tippfehler-Korrektur)'
            agentic_mcp_tool 'knowledge_base_retrieve (Foundry IQ MCP-Server Endpunkt auf Port 443)'
          }
        }
      }

      // 5. Relational Policy Admin Core (PAS)
      sql_pas = store 'Azure SQL: pas-core' {
