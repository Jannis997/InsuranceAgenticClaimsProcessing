// Enterprise Agentic Claims Architecture on Microsoft Azure, Foundry & Databricks
// =============================================================================

#set document(
  title: "Enterprise Agentic Claims Architecture Blueprint (Azure, Foundry & Databricks)",
  author: "Jannis Ebling",
)

#set page(
  paper: "a4",
  margin: (top: 1.1cm, bottom: 1.1cm, left: 1.2cm, right: 1.2cm),
  footer: context [
    #set text(size: 7.5pt, fill: rgb("#64748b"))
