        table_pas_claims = schema_entity 'Table: Claims' {
          #schema_def #versioning
          summary 'Bestands-Schadensakten (ClaimId, PolicyId, AppliedAvbVersionId, Status)'
          description '''
            ### Schema: `dbo.Claims`
