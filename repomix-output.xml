    // -----------------------------------------------------------------------
    // D. DETERMINISTIC RULES ENGINE & POLICY MANAGEMENT (4-AUGEN-WORKFLOW)
    // -----------------------------------------------------------------------
    rules_engine = rules_engine 'Deterministic Rules Runtime' {
      #deterministic #private_endpoint #versioning
      summary 'Einheitliche, versionierte Rules Engine für historische AVB-Tarife & interne Unternehmensregeln'
      icon bootstrap:gear-wide-connected
      description '''
        **Deterministische Ausführung & Datenstrukturen (Input / Output):**
        Die Engine enthält **ein einziges, versioniertes Rule Repository**, in dem sowohl die historisch gebundenen AVB-Regeln (`avbVersionId`) als auch die zum Stichtag gültigen internen Unternehmensregeln liegen.

        ### Beispiel Input-Struktur (`RulesEvaluationRequest`):
        ```json
        {
          "claimId": "CLM-2026-9812",
          "claimType": "AUTO_GLASS",
          "contract": {
            "policyNumber": "POL-2021-8812",
            "contractCreatedAt": "2021-05-14",
            "boundAvbVersionId": "AVB-KFZ-2021-V1",
            "deductibleAmount": 150.00,
            "coverageLimit": 5000.00
          },
          "claimFacts": {
            "lossDate": "2026-03-12",
            "isPartnerWorkshop": true,
            "lineItems": [
              { "tariffCode": "GLAS_WINDSHIELD_REPL", "claimedAmount": 420.00, "laborHours": 2.5 },
              { "tariffCode": "ADAS_CAMERA_CALIB", "claimedAmount": 165.00, "laborHours": 1.0 }
            ]
          }
        }
        ```

        ### Beispiel Output-Struktur (`RulesEvaluationResponse`):
        ```json
        {
          "evaluationId": "EVAL-99412",
          "deterministicStatus": "APPROVED_PARTIAL",
          "appliedRules": [
            { "ruleId": "AVB-2021-GLAS-01", "version": "1.0", "type": "CONTRACTUAL_AVB", "effect": "Maximaler Stundensatz 140 EUR" },
            { "ruleId": "CORP-PARTNER-BONUS-04", "version": "3.2", "type": "INTERNAL_POLICY", "effect": "Halbierung SB bei Partnerwerkstatt (-75 EUR)" }
          ],
          "calculationBreakdown": {
            "totalClaimed": 585.00,
            "tariffCapDeduction": -30.00,
            "eligibleAmount": 555.00,
            "appliedDeductible": -75.00,
            "finalNetPayout": 480.00
          }
        }
        ```
      '''

      rule_evaluator = compute 'Deterministic DSL Evaluator & Schema Validator' {
        #deterministic
        summary 'Prüft Input-Schema, lädt passende Regelversionen & berechnet exakt das Output-JSON'
        icon bootstrap:sliders
      }

      versioned_rule_repo = rule_store 'Unified Versioned Rule Repository' {
        #versioning
        summary 'Speichert alle historischen AVB-Regelgenerationen & versionierten internen Unternehmensregeln'
        icon bootstrap:archive-fill
      }
    }

    rule_authoring_subsystem = pipeline 'Policy Management & Rule Authoring' {
      #versioning #security
      summary 'Steuert & aktualisiert die Rules Engine (AVB-Generationen & interne Regeln im 4-Augen-Prozess)'
      icon bootstrap:file-earmark-code
      description '''
        **Auf Level 1 als kompakte Einheit dargestellt – im Drill-Down (Level 2C) mit allen 3 Rollen & 5 Prüfschritten:**
        1. **Zwei Intakes:** Vertragliche AVBs (`actuary_legal`) & interne Unternehmensregeln (`business_analyst`).
        2. **KI-Transformation:** Übersetzung in typisiertes DSL + Unit-Tests.
        3. **Z3-Konfliktprüfung & Backtesting:** Mathematische Widerspruchsprüfung & Simulation gegen 10.000 historische Claims.
        4. **4-Augen-Freigabe:** `risk_compliance_manager` prüft den finanziellen Impact und gibt das Deployment frei.
      '''

      avb_intake = compute '1A. AVB & Tarifwerk-Ingestion (Vertraglich)' {
        #versioning
        summary 'Extrahiert neue AVB-Generation, indexiert Text in AI Search & übergibt Klauseln'
        icon bootstrap:file-earmark-medical
      }

      internal_rule_intake = app_ui '1B. Natural-Language Rule Studio (Interne Regeln)' {
        summary 'UI für Business Analysten: Eingabe interner Unternehmensregeln in natürlicher Sprache'
        icon bootstrap:terminal
      }

      authoring_agent = agent '2. Rule & Policy Authoring Agent (NL-to-DSL)' {
        summary 'Generiert aus AVB-Klauseln oder Freitext typisiertes YAML-DSL & synthetische Unit-Tests'
        icon bootstrap:robot
      }

      conflict_simulator = compute '3. SMT Conflict Solver & Historical Backtester' {
        #deterministic
        summary 'Prüft Logik-Konflikte per Z3-Solver & simuliert finanziellen Impact auf 10.000 historische Claims'
        icon bootstrap:intersect
      }

      impact_approval_portal = app_ui '4. Governance & Impact Approval Portal (4-Augen-UI)' {
        #security #versioning
        summary 'Entscheidungs-UI für den 2. Prüfer: Zeigt Regel-Diff, Konfliktbericht & Backtest-Finanz-Impact'
        icon bootstrap:clipboard-data
      }

      rule_deployer = compute '5. Versioned Rule Compiler & CI/CD Deployer' {
        #versioning
        summary 'Kompiliert freigegebene Regeln nach Sign-Off in das Unified Versioned Rule Repository'
        icon bootstrap:cloud-upload
      }
    }

    // -----------------------------------------------------------------------
    // E. CIRCUIT BREAKER & HITL SACHBEARBEITER-APPLIKATION
    // -----------------------------------------------------------------------
    governance_svc = governance '4. Circuit Breaker & HITL Escalation Platform' {
      #hitl #security
      summary 'Deterministische Guardrail-Middleware, Dokumenten-Highlighting, HITL-Workbench & Direkt-Abwicklung'
      icon bootstrap:shield-exclamation

      circuit_breaker = governance '1. Deterministic Circuit Breaker Middleware' {
        #hitl #security #deterministic
        summary 'Code-basierter Interceptor: Prüft JSON-Outputs nach jedem Schritt & fängt Orchestrator-Eskalationen ab'
        icon bootstrap:exclamation-octagon-fill
      }

      dossier_compiler = compute '2. AI Summary & Document Highlighting Compiler' {
        #hitl
        summary 'Erstellt Fall-Zusammenfassung, markiert Eskalationsgründe & highlighted Stellen per Bounding-Box'
        icon bootstrap:highlighter
      }

      adjuster_notifier = compute '3. Priority Routing & Notification Service' {
        #hitl
        summary 'Benachrichtigt den Spezial-Sachbearbeiter über den neuen HITL-Fall'
        icon bootstrap:bell-fill
      }

      adjuster_app = app_ui '4. Specialist Adjuster Workbench App (HITL UI)' {
        #hitl #pii_protected
        summary 'Sachbearbeiter-App: Zeigt KI-Summary, gehighlightete Originaldokumente & Gründe (de-tokenisiert PII)'
        icon bootstrap:display
      }

      direct_hitl_executor = compute '5. Direct HITL Settlement & Letter Executor (Kein Agent)' {
        #deterministic #hitl
        summary 'Setzt finale Sachbearbeiter-Entscheidungen (Ablehnung / Großschaden-Zahlung) direkt & deterministisch um'
        icon bootstrap:check2-square
      }
    }

    // -----------------------------------------------------------------------
    // F. LANGFUSE OBSERVABILITY & PROMPT MANAGEMENT
    // -----------------------------------------------------------------------
    langfuse = observability 'Langfuse Observability & Prompt Platform' {
      #observability #pii_protected #private_endpoint
      summary 'Self-Hosted im Azure VNet: Verwaltet Systemprompts/Skills & zeichnet PII-freie Traces auf'
      icon bootstrap:activity

      otel_pii_gateway = compute '1. OpenTelemetry Collector & Azure AI PII Guard' {
        #pii_protected #security
        summary 'Nimmt OTel-Traces von Agenten & Circuit Breaker entgegen und filtert Freitext-PII via Azure AI Language'
        icon bootstrap:funnel-fill
      }

      langfuse_core = observability '2. Langfuse Tracing & Cost Analytics Server' {
        #observability
        summary 'Speichert Agenten-Traces, Latenz-Spans, Token-Kosten & Circuit-Breaker-Events'
        icon bootstrap:graph-up
      }

      prompt_registry = observability '3. Langfuse Prompt & Claim-Type Skill Registry' {
        #observability #versioning
        summary 'Liefert versionierte Systemprompts, Agenten-Instruktionen & Checklisten je Schadensart zur Laufzeit'
        icon bootstrap:braces-asterisk
      }

      eval_engine = observability '4. Langfuse Evaluation & HITL Dataset Engine' {
        #observability
        summary 'Misst Groundedness-Scores & speichert Sachbearbeiter-Overrides als Benchmark-Datasets'
        icon bootstrap:award
      }
    }

    // -----------------------------------------------------------------------
    // G. DEFINIERTE OUTCOMES
    // -----------------------------------------------------------------------
    claims_outcomes = subsystem 'Claims Processing Outcomes' {
      summary 'Die drei definierten End-Zustände der Schadenbearbeitung'

      outcome_stp = outcome 'Komplette Dunkelverarbeitung (STP)' {
        summary 'Vollautomatische Regulierung, Auszahlung & EOB-Versand ohne menschlichen Eingriff'
        icon bootstrap:check2-circle
      }
      outcome_comm = outcome 'Customer Communication Loop' {
        summary 'Schadensartspezifische Dokumenten-Nachforderung oder Zustellung des Abrechnungsschreibens'
        icon bootstrap:chat-dots
      }
      outcome_hitl = outcome 'HITL-Abschluss (Durch Spezialist entschieden)' {
        summary 'Abgeschlossene manuelle Freigabe, Kürzung oder geprüfte Ablehnung (ohne erneuten Agenten-Lauf)'
        icon bootstrap:person-check-fill
      }
    }

    // -----------------------------------------------------------------------
    // H. PERSISTENTE AZURE DATA STORES (AUF LEVEL 1 ALS EINE KOMPAKTE BOX)
    // -----------------------------------------------------------------------
    data_stores = store 'Secured Azure Data & Knowledge Platform (Private Link)' {
      #security #private_endpoint #pii_protected
      summary 'Konsolidierte Datenhaltung (Blobs, Cosmos DB, AI Search, PAS SQL) – komplett hinter Private Endpoints'
      icon bootstrap:database-fill-lock
      description '''
        ### Datenschutz-, Privacy- & Security-Matrix der 5 Speicher (Klicke auf Lupe für Tabellen-Drill-Down)
        Alle Speicher sind ausschließlich über **Azure Private Endpoints (`privatelink.*`)** im isolierten VNet erreichbar und mit **Customer-Managed Keys (CMK)** im Azure Key Vault verschlüsselt.

        | Azure Ressource | Gespeicherte Daten | PII / Datenschutz-Status | Zugriff durch KI-Agenten (LLMs) |
        | :--- | :--- | :--- | :--- |
        | **1. Azure Blob (`raw-artifacts`)** | Original-PDFs, Schadensfotos, Audio, EOB-PDFs | **Enthält Original-PII** (WORM Legal Hold) | **Kein direkter LLM-Textzugriff** (nur Hash-Prüfung & HITL-Viewer) |
        | **2. Azure Blob (`extracted-state`)** | Extrahierte JSONs, Tabellen & Bounding-Boxes | **Pseudonymisiert** (`<PII:NAME_1>`, `<PII:IBAN_1>`) | **Ja** (sicher, da PII bereits durch Tokens ersetzt) |
        | **3a. Cosmos DB (`claim_dossiers` & `hitl`)** | Schadenakte, Checkliste, Rules-Output, HITL-Dossier | **Pseudonymisiert** (arbeitet mit `claimId` & Tokens) | **Ja** (über typisierte MCP-Tools) |
        | **3b. Cosmos DB (`pii_token_vault`)** | Mapping `<PII:IBAN_1>` &rarr; echte IBAN / Name | **Streng vertraulich (Klartext-PII Vault)** | **NEIN (Strikt gesperrt für LLMs!)** Nur für deterministische Ausgangs-Adapter & HITL-UI |
        | **4. Azure AI Search (`policy-knowledge`)** | Historische & aktuelle AVB-Generationen, Tarife | **Keine PII** (reine Produkt- & Rechtsdokumente) | **Ja** (Read-Only RAG mit `AvbVersionId`-Filter) |
        | **5. Azure SQL (`pas-core`)** | Verträge, Deckungslimits, `AvbVersionId`, Claims | **Pseudonymisierter Lesezugriff** über `PolicyNumber` | **Nur über eingeschränkte MCP-Views** (ohne Klartext-Kontodaten) |
      '''
      metadata {
        network_isolation '100% Azure Private Link (No Public Internet Endpoints)'
        key_management 'Azure Key Vault HSM (Customer-Managed Keys)'
        gdpr_deletion 'Automated TTL & Crypto-Shredding via pii_token_vault'
      }

      // 0. Security & Key Vault Node (Sichtbar im Store Drill-Down)
      security_vault = governance 'Azure Key Vault & Private Link DNS' {
        #security #private_endpoint
        summary 'Verwaltet Customer-Managed Keys (CMK), Private DNS Zones & Managed Identity Policies'
        icon bootstrap:shield-lock-fill
      }

      // 1. Raw Document Blob
      blob_raw = store 'Azure Blob: raw-artifacts' {
        #private_endpoint
        summary 'Container für Original-Uploads des Kunden (PDF, Fotos, Audio) & generierte EOB-PDFs'
        icon bootstrap:archive
        description '''
          ### Storage: `raw-artifacts` (Private Endpoint: `privatelink.blob.core.windows.net`)
          | Eigenschaft | Wert / Beschreibung |
          | :--- | :--- |
          | **Pfad-Struktur** | `/{tenantId}/{claimId}/raw/{documentId}_{filename}` |
          | **PII-Klassifizierung** | **Hoch (Originaldokumente)** – Zugriff nur für Extraktions-Pipeline, EOB-Archivierung & HITL-Viewer |
          | **Rechtssicherheit** | Time-based retention (WORM Legal Hold) |
        '''
      }

      // 2. Extracted State Blob
      blob_state = store 'Azure Blob: extracted-state' {
        #pii_protected #private_endpoint
        summary 'Pseudonymisierte Extraktions-JSONs (<PII:...>) inkl. Bounding-Boxes für Highlighting'
        icon bootstrap:file-earmark-code
        description '''
          ### Schema: `canonical-claim.json` (Pseudonymisiert – Sicher für KI-Agenten)
          | Feld | Typ | Beschreibung |
          | :--- | :--- | :--- |
          | **claimId** | `string` | Eindeutige Schadennummer (`CLM-2026-9812`) |
          | **claimType** | `enum` | `AUTO_GLASS`, `WATER_DAMAGE`, `BODILY_INJURY`, etc. |
          | **overallConfidence** | `float` | Aggregierte Extraktions-Konfidenz (`0.00 - 1.00`) |
          | **sanitizedText** | `string` | Text mit Platzhaltern (`<PII:CLAIMANT_NAME_1>`, `<PII:IBAN_1>`) |
          | **extractedFields** | `array` | `{ fieldName, tokenOrValue, confidence, page, boundingBox: [x1,y1,x2,y2] }` |
        '''
      }

      // 3. Transactional Claims Cosmos DB
      cosmos_claims = store 'Azure Cosmos DB: active-claims' {
        #private_endpoint #pii_protected
        summary 'Operative Schadenakten, PII-Token-Vault, HITL-Dossiers & Audit-Trail'
        icon bootstrap:database-fill-gear

        table_claim_dossier = schema_entity 'Container: claim_dossiers' {
          #schema_def #versioning
          summary 'Operative Schadenakte inkl. gebundener AvbVersionId, Checkliste & Rules-Ergebnis'
          description '''
            ### Container: `claim_dossiers` (Partition Key: `/claimId`)
            | Feld | Datentyp | Beschreibung |
            | :--- | :--- | :--- |
            | **id** | `string [PK]` | Eindeutige Dossier-ID (`CLM-2026-9812`) |
            | **policyNumber** | `string` | Verknüpfte Vertragsnummer |
            | **boundAvbVersionId** | `string` | **Historische AVB-Generation bei Vertragsabschluss** (`AVB-KFZ-2021-V1`) |
            | **claimType** | `string` | Schadensart (steuert Playbook, Prompts & Checkliste) |
            | **checklistStatus** | `object` | `{ requiredDocs: [...], receivedDocs: [...], isComplete: boolean }` |
            | **rulesEvaluation** | `object` | Vollständiger `RulesEvaluationResponse` der deterministischen Rules Engine |
            | **agentDecisions** | `array` | `{ agent, rationale, confidence, citedClauses, timestamp }` |
          '''
        }

        table_hitl_queue = schema_entity 'Container: hitl_escalations' {
          #schema_def #hitl
          summary 'Aufbereitete HITL-Fälle mit KI-Zusammenfassung, Eskalationsgründen & Highlight-Koordinaten'
          description '''
            ### Container: `hitl_escalations` (Partition Key: `/escalationId`)
            | Feld | Datentyp | Beschreibung |
            | :--- | :--- | :--- |
            | **escalationId** | `string [PK]` | UUID des HITL-Eskalationsfalls |
            | **claimId** | `string` | Referenzierte Schadenakte |
            | **escalationType** | `enum` | `EXTRACTION_LOW_CONFIDENCE` (Resume Agent) \| `TERMINAL_DECISION` (Denial/HighSum/Fraud) |
            | **triggerReasons** | `array<string>` | Klartext-Erklärung für das rote Banner in der Sachbearbeiter-App |
            | **executiveSummary** | `markdown` | Kompakte KI-Zusammenfassung des Falls |
            | **documentHighlights** | `array` | `{ docUri, page, boundingBox, color, label, confidence }` |
          '''
        }

        table_pii_vault = schema_entity 'Container: pii_token_vault (Strictly Secured)' {
          #schema_def #pii_protected #security
          summary 'Hochgesicherte Zuordnungstabelle zwischen Platzhalter-Tokens (<PII:IBAN_1>) & Klartext'
          description '''
            ### Container: `pii_token_vault` (Partition Key: `/claimId`, Always Encrypted / CMK)
            **Kein LLM hat Zugriff auf diesen Container!** Nur die deterministischen Ausgangs-Adapter (MCP-Tools für ERP-Zahlung, Briefversand) und die HITL-Workbench dürfen Tokens auflösen (De-Tokenization).

            | Feld | Datentyp | Beschreibung |
            | :--- | :--- | :--- |
            | **claimId** | `string [PK]` | Zugehörige Schadennummer |
            | **tokenMap** | `map<string,string>`| `{ "<PII:CLAIMANT_NAME_1>": "Max Mustermann", "<PII:IBAN_1>": "DE893704..." }` |
            | **createdAt** | `datetime` | Zeitpunkt der Tokenisierung bei der Extraktion |
            | **retentionExpiry** | `datetime` | Automatische Löschfrist nach DSGVO (Crypto-Shredding) |
          '''
        }
      }

      // 4. Vector Store (Azure AI Search)
      vector_search = store 'Azure AI Search: policy-knowledge' {
        #versioning #private_endpoint
        summary 'Versionierter Hybrid-Vektor-Index für alle historischen & aktuellen AVB-Generationen'
        icon bootstrap:search

        table_vector_index = schema_entity 'Index: policy-knowledge-idx' {
          #schema_def #versioning
          summary 'Speichert alle AVB-Generationen & Reparatur-Richtlinien (Filterbar nach avbVersionId)'
          description '''
            ### Index: `policy-knowledge-idx`
            | Feld | Typ | Attribute / Sucheigenschaften |
            | :--- | :--- | :--- |
            | **chunkId** | `String [Key]` | Eindeutiger Klausel-Chunk-Identifier |
            | **avbVersionId** | `String [Filter]` | **Exakte AVB-Generation** (z.B. `AVB-KFZ-2019-V1`, `AVB-KFZ-2026-V2`) |
            | **docCategory** | `String [Filter]` | `CONTRACTUAL_AVB`, `TARIFF_TABLE`, `REPAIR_GUIDELINE` |
            | **productLine** | `String [Filter]` | Sparte / Schadensart (`AUTO_GLASS`, `WATER_DAMAGE`, etc.) |
            | **clauseCode** | `String [Filter]` | Paragraphen-Referenz (`§ 12 Abs. 2 AKB`) |
            | **clauseText** | `String [Search]` | Exakter juristischer Wortlaut für RAG & EOB-Zitate |
            | **embedding** | `Vector(3072)` | HNSW-Vektor für semantische Suche |
          '''
        }
      }

      // 5. Relational Policy Admin Core (PAS)
      sql_pas = store 'Azure SQL: pas-core' {
        #versioning #private_endpoint
        summary 'Bestandssystem: Kunden, Verträge (mit fest gebundener AvbVersionId), Deckungen & Schäden'
        icon bootstrap:database

        table_customers = schema_entity 'Table: Customers' {
          #schema_def
          summary 'Kundenstamm (CustomerId, CustomerNumber, Risikostatus, Auth-Binding)'
          description '''
            ### Schema: `dbo.Customers`
            | Spalte | Datentyp | Constraints / Referenzen | Beschreibung |
            | :--- | :--- | :--- | :--- |
            | **CustomerId** | `BIGINT` | `PK`, `IDENTITY(1,1)` | Eindeutige Kunden-ID |
            | **CustomerNumber** | `VARCHAR(30)` | `NOT NULL`, `UNIQUE` | Externe Kundennummer |
            | **RiskClassification** | `VARCHAR(20)` | `NOT NULL` | Risikoklasse (`LOW`, `MEDIUM`, `HIGH`) |
            | **EntraObjectId** | `UNIQUEIDENTIFIER`| `NOT NULL` | Verknüpfung für Kunden-Authentifizierung |
          '''
        }

        table_policies = schema_entity 'Table: Policies' {
          #schema_def #versioning
          summary 'Verträge inkl. Vertragsabschlussdatum & der dauerhaft gültigen AvbVersionId'
          description '''
            ### Schema: `dbo.Policies`
            | Spalte | Datentyp | Constraints / Referenzen | Beschreibung |
            | :--- | :--- | :--- | :--- |
            | **PolicyId** | `BIGINT` | `PK`, `IDENTITY(1,1)` | Eindeutige interne ID der Police |
            | **CustomerId** | `BIGINT` | `FK` &rarr; `Customers(CustomerId)` | Versicherungsnehmer |
            | **PolicyNumber** | `VARCHAR(50)` | `NOT NULL`, `UNIQUE` | Externe Vertragsnummer (`POL-2021-8812`) |
            | **ProductLine** | `VARCHAR(30)` | `NOT NULL` | Sparte (`AUTO_COMPREHENSIVE`, `BUILDING`) |
            | **ContractCreatedAt**| `DATETIME2` | `NOT NULL` | **Zeitpunkt des Vertragsabschlusses (Stichtag für AVB!)** |
            | **AvbVersionId** | `VARCHAR(40)` | `NOT NULL` | **Dauerhaft gültige AVB-Generation** (`AVB-KFZ-2021-V1`) |
            | **Status** | `VARCHAR(20)` | `NOT NULL` | `ACTIVE`, `SUSPENDED`, `CANCELLED` |
          '''
        }

        table_coverages = schema_entity 'Table: Coverages & Endorsements' {
          #schema_def
          summary 'Vertraglich vereinbarte Deckungssummen, Tarifbausteine & Selbstbehalte'
          description '''
            ### Schema: `dbo.Coverages`
            | Spalte | Datentyp | Constraints / Referenzen | Beschreibung |
            | :--- | :--- | :--- | :--- |
            | **CoverageId** | `BIGINT` | `PK`, `IDENTITY(1,1)` | Eindeutige Deckungs-ID |
            | **PolicyId** | `BIGINT` | `FK` &rarr; `Policies(PolicyId)` | Referenzierte Police |
            | **CoverageCode** | `VARCHAR(30)` | `NOT NULL` | Baustein (`AUTO_GLASS`, `WATER`, `LIABILITY`) |
            | **LimitAmount** | `DECIMAL(12,2)` | `NOT NULL` | Maximale Deckungssumme |
            | **DeductibleAmount** | `DECIMAL(12,2)` | `NOT NULL` | Vereinbarte Selbstbeteiligung |
          '''
        }

        table_pas_claims = schema_entity 'Table: Claims' {
          #schema_def #versioning
          summary 'Bestands-Schadensakten (ClaimId, PolicyId, AppliedAvbVersionId, Status)'
          description '''
            ### Schema: `dbo.Claims`
            | Spalte | Datentyp | Constraints / Referenzen | Beschreibung |
            | :--- | :--- | :--- | :--- |
            | **ClaimId** | `BIGINT` | `PK`, `IDENTITY(1,1)` | Interne Schaden-ID |
            | **ClaimNumber** | `VARCHAR(40)` | `NOT NULL`, `UNIQUE` | Externe Schadennummer |
            | **PolicyId** | `BIGINT` | `FK` &rarr; `Policies(PolicyId)` | Zugehörige Police |
            | **CustomerId** | `BIGINT` | `FK` &rarr; `Customers(CustomerId)` | Authentifizierter Kunde |
            | **AppliedAvbVersionId**| `VARCHAR(40)` | `NOT NULL` | Aus dem Vertrag übernommene historische AVB-Version |
            | **ClaimType** | `VARCHAR(30)` | `NOT NULL` | Schadensart (`AUTO_GLASS`, `WATER_DAMAGE`, etc.) |
            | **ClaimStatus** | `VARCHAR(20)` | `NOT NULL` | `OPEN`, `HITL_REVIEW`, `SETTLED`, `DENIED` |
            | **TotalPaidAmount** | `DECIMAL(12,2)` | `DEFAULT 0.00` | Ausgezahlter Erstattungsbetrag |
          '''
        }
      }
    }
  }

  // =========================================================================
  // 3. EXTERNAL ERP (Nur in Level 2 & 3 sichtbar, nicht auf Level 1)
  // =========================================================================
  erp_finance = external_system 'Core ERP & Settlement (SAP / Banking)' {
    summary 'Überweisung & Buchung im Hauptbuch (GL/AP)'
    icon bootstrap:building-check
  }

  // =========================================================================
  // 4. BEZIEHUNGEN & WORKFLOWS
  // =========================================================================

  // --- Entry & Stage 1: Extraktion & PII-Tokenization ---
  claimant -> channels 'Meldet Schaden & Belege'
  channels -> azure_vnet.extraction_pipeline.front_door_apim 'HTTPS Payload + Auth'
  azure_vnet.extraction_pipeline.front_door_apim -> azure_vnet.extraction_pipeline.ingestion_event_hub 'Geprüfter Traffic'
  azure_vnet.extraction_pipeline.ingestion_event_hub -> azure_vnet.extraction_pipeline.channel_router '1. Roh-Event'

  azure_vnet.extraction_pipeline.channel_router -> azure_vnet.data_stores.blob_raw 'Original speichern'
  azure_vnet.extraction_pipeline.channel_router -> azure_vnet.extraction_pipeline.speech_svc 'Audio / IVR'
  azure_vnet.extraction_pipeline.channel_router -> azure_vnet.extraction_pipeline.doc_intel 'PDF / Rechnung'
  azure_vnet.extraction_pipeline.channel_router -> azure_vnet.extraction_pipeline.vision_svc 'Schadensfoto'
  azure_vnet.extraction_pipeline.channel_router -> azure_vnet.extraction_pipeline.lang_svc 'E-Mail / Chat'

  azure_vnet.extraction_pipeline.speech_svc -> azure_vnet.extraction_pipeline.lang_svc 'Transkript'
  azure_vnet.extraction_pipeline.doc_intel -> azure_vnet.extraction_pipeline.lang_svc 'Roh-Text'
  azure_vnet.extraction_pipeline.lang_svc -> azure_vnet.extraction_pipeline.translator_svc 'Fremdsprache'

  azure_vnet.extraction_pipeline.doc_intel -> azure_vnet.extraction_pipeline.pii_tokenizer 'Tabellen & Boxes'
  azure_vnet.extraction_pipeline.vision_svc -> azure_vnet.extraction_pipeline.pii_tokenizer 'Bild-Analyse'
  azure_vnet.extraction_pipeline.lang_svc -> azure_vnet.extraction_pipeline.pii_tokenizer 'Entitäten & PII'
  azure_vnet.extraction_pipeline.translator_svc -> azure_vnet.extraction_pipeline.pii_tokenizer 'Übersetzung'

  azure_vnet.extraction_pipeline.pii_tokenizer -> azure_vnet.data_stores.cosmos_claims.table_pii_vault 'PII-Mapping (<PII:IBAN_1>)'
  azure_vnet.extraction_pipeline.pii_tokenizer -> azure_vnet.data_stores.blob_state 'Pseudonymisiertes JSON'

  // --- Stage 2: Klassifikation & Deterministische Schadenanlage ---
  azure_vnet.extraction_pipeline.pii_tokenizer -> azure_vnet.classification_pipeline.check_preclassified 'Extrahierte Daten'
  azure_vnet.classification_pipeline.check_preclassified -> azure_vnet.governance_svc.dossier_compiler 'OCR < 0.80 (HITL)'
  azure_vnet.classification_pipeline.check_preclassified -> azure_vnet.classification_pipeline.pas_claim_creator 'Pfad A: Vorklassifiziert'
  azure_vnet.classification_pipeline.check_preclassified -> azure_vnet.classification_pipeline.classifier_service 'Pfad B: Unstrukturiert'
  azure_vnet.classification_pipeline.classifier_service -> azure_vnet.classification_pipeline.pas_claim_creator 'Schadensart & Schwere'

  azure_vnet.classification_pipeline.pas_claim_creator -> azure_vnet.data_stores.sql_pas.table_policies 'Liest Vertrag & AvbVersionId'
  azure_vnet.classification_pipeline.pas_claim_creator -> azure_vnet.data_stores.sql_pas.table_pas_claims 'Legt PAS-Schaden an'
  azure_vnet.classification_pipeline.pas_claim_creator -> azure_vnet.data_stores.cosmos_claims.table_claim_dossier 'Initialisiert Dossier'
  azure_vnet.classification_pipeline.pas_claim_creator -> azure_vnet.multi_agent_system.claims_event_bus 'Übergibt angelegten Schaden'

  // --- Stage 3: Multi-Agent System & Langfuse Prompt Loading ---
  azure_vnet.multi_agent_system.claims_event_bus -> azure_vnet.multi_agent_system.playbook_loader '1. Nimmt Schaden aus Queue'
  azure_vnet.multi_agent_system.playbook_loader -> azure_vnet.langfuse.prompt_registry '2. Lädt Prompts & Checkliste'
  azure_vnet.multi_agent_system.playbook_loader -> azure_vnet.multi_agent_system.orchestrator '3. Startet Orchestrator'

  // --- Orchestrator <-> Sub-Agents ---
  azure_vnet.multi_agent_system.orchestrator <-> azure_vnet.multi_agent_system.customer_agent 'Checkliste & EOB'
  azure_vnet.multi_agent_system.orchestrator <-> azure_vnet.multi_agent_system.coverage_agent 'Deckung (AvbVersionId)'
  azure_vnet.multi_agent_system.orchestrator <-> azure_vnet.multi_agent_system.fraud_agent 'Betrugs- & Risiko-Check'
  azure_vnet.multi_agent_system.orchestrator <-> azure_vnet.multi_agent_system.adjudication_agent 'Tarif-Mapping & Rules'
  azure_vnet.multi_agent_system.orchestrator <-> azure_vnet.multi_agent_system.financial_agent 'STP-Auszahlung & Reserven'

  // --- Generator-Critic Internal Loops & MCP Tool Calls ---
  // 1. Customer Agent
  azure_vnet.multi_agent_system.customer_agent.comm_critic -> azure_vnet.multi_agent_system.customer_agent.tool_gen_eob 'Gibt EOB-Entwurf frei'
  azure_vnet.multi_agent_system.customer_agent.tool_request_docs -> azure_vnet.data_stores.cosmos_claims.table_claim_dossier 'Liest offene Checkliste'
  azure_vnet.multi_agent_system.customer_agent.tool_request_docs -> channels 'Rückfrage / EOB an Kunden'
  azure_vnet.multi_agent_system.customer_agent.tool_send_msg -> azure_vnet.data_stores.cosmos_claims.table_pii_vault 'De-tokenisiert Empfänger'
  azure_vnet.multi_agent_system.customer_agent.tool_send_msg -> channels 'Rückfrage / EOB an Kunden'
  azure_vnet.multi_agent_system.customer_agent.tool_gen_eob -> azure_vnet.data_stores.vector_search.table_vector_index 'Liest AVB-Zitate (AvbVersionId)'
  azure_vnet.multi_agent_system.customer_agent.tool_gen_eob -> azure_vnet.data_stores.cosmos_claims.table_claim_dossier 'Liest Abrechnungsdetails'
  azure_vnet.multi_agent_system.customer_agent.tool_gen_eob -> azure_vnet.data_stores.cosmos_claims.table_pii_vault 'De-tokenisiert Name & IBAN'
  azure_vnet.multi_agent_system.customer_agent.tool_gen_eob -> azure_vnet.data_stores.blob_raw 'Speichert EOB-PDF'
  azure_vnet.multi_agent_system.customer_agent.tool_gen_eob -> channels 'Rückfrage / EOB an Kunden'

  // 2. Coverage Agent
  azure_vnet.multi_agent_system.coverage_agent.tool_get_policy -> azure_vnet.data_stores.sql_pas.table_policies 'Liest Vertrag & AvbVersionId'
  azure_vnet.multi_agent_system.coverage_agent.tool_get_policy -> azure_vnet.data_stores.sql_pas.table_coverages 'Liest Limits & SB'
  azure_vnet.multi_agent_system.coverage_agent.tool_search_clauses -> azure_vnet.data_stores.vector_search.table_vector_index 'Suche (Filter: AvbVersionId)'
  azure_vnet.multi_agent_system.coverage_agent.tool_save_coverage -> azure_vnet.data_stores.cosmos_claims.table_claim_dossier 'Speichert Deckung'

  // 3. Fraud Agent
  azure_vnet.multi_agent_system.fraud_agent.tool_check_image_hash -> azure_vnet.data_stores.blob_raw 'Prüft Bild-Hashes'
  azure_vnet.multi_agent_system.fraud_agent.tool_check_image_hash -> azure_vnet.data_stores.cosmos_claims.table_claim_dossier 'Dubletten-Abgleich'
  azure_vnet.multi_agent_system.fraud_agent.tool_score_anomaly -> azure_vnet.data_stores.sql_pas.table_pas_claims 'Liest Vorschäden'
  azure_vnet.multi_agent_system.fraud_agent.tool_score_anomaly -> azure_vnet.data_stores.sql_pas.table_customers 'Liest Risikoklasse'
  azure_vnet.multi_agent_system.fraud_agent.tool_score_anomaly -> azure_vnet.data_stores.blob_state 'Liest Rechnungs-Features'

  // 4. Adjudication Agent
  azure_vnet.multi_agent_system.adjudication_agent.tool_map_items -> azure_vnet.data_stores.blob_state 'Liest Rechnungspositionen'
  azure_vnet.multi_agent_system.adjudication_agent.tool_map_items -> azure_vnet.data_stores.vector_search.table_vector_index 'Liest Tarif-Richtlinien'
  azure_vnet.multi_agent_system.adjudication_agent.coding_critic -> azure_vnet.multi_agent_system.adjudication_agent.tool_exec_rules 'Gibt Code-Mapping frei'
  azure_vnet.multi_agent_system.adjudication_agent.tool_exec_rules -> azure_vnet.rules_engine.rule_evaluator 'Berechnet Tarif & SB'
  azure_vnet.rules_engine.rule_evaluator -> azure_vnet.rules_engine.versioned_rule_repo 'Lädt Regelversion'
  azure_vnet.multi_agent_system.adjudication_agent.tool_exec_rules -> azure_vnet.data_stores.cosmos_claims.table_claim_dossier 'Speichert Rules-Output'

  // 5. Financial Agent
  azure_vnet.multi_agent_system.financial_agent.tool_post_payment -> azure_vnet.data_stores.cosmos_claims.table_pii_vault 'De-tokenisiert <PII:IBAN_1>'
  azure_vnet.multi_agent_system.financial_agent.tool_post_payment -> erp_finance 'SEPA-Auszahlung (AP/GL)'
  azure_vnet.multi_agent_system.financial_agent.tool_update_reserve -> azure_vnet.data_stores.cosmos_claims.table_claim_dossier 'Status: SETTLED'
  azure_vnet.multi_agent_system.financial_agent.tool_update_reserve -> azure_vnet.data_stores.sql_pas.table_pas_claims 'Synchronisiert PAS-Akte'

  // --- Stage 4: Policy Management & Rule Authoring (4-Augen-Workflow) ---
  actuary_legal -> azure_vnet.rule_authoring_subsystem.avb_intake '1A. Neue AVB-Generation'
  azure_vnet.rule_authoring_subsystem.avb_intake -> azure_vnet.data_stores.vector_search.table_vector_index 'Indexiert neue AVB-Version'
  azure_vnet.rule_authoring_subsystem.avb_intake -> azure_vnet.rule_authoring_subsystem.authoring_agent 'Tarif- & Deckungsklauseln'

  business_analyst -> azure_vnet.rule_authoring_subsystem.internal_rule_intake '1B. Interne Regel (Freitext)'
  azure_vnet.rule_authoring_subsystem.internal_rule_intake -> azure_vnet.rule_authoring_subsystem.authoring_agent 'Natürlichsprachige Regel'

  azure_vnet.rule_authoring_subsystem.authoring_agent -> azure_vnet.rule_authoring_subsystem.conflict_simulator '2. Typisiertes DSL & Tests'
  azure_vnet.rule_authoring_subsystem.conflict_simulator -> azure_vnet.data_stores.cosmos_claims.table_claim_dossier '3. Backtest (10.000 Claims)'
  azure_vnet.rule_authoring_subsystem.conflict_simulator -> azure_vnet.rule_authoring_subsystem.impact_approval_portal '4. Konfliktbericht & Impact'

  risk_compliance_manager -> azure_vnet.rule_authoring_subsystem.impact_approval_portal '5. Prüft Impact & gibt frei'
  azure_vnet.rule_authoring_subsystem.impact_approval_portal -> azure_vnet.rule_authoring_subsystem.rule_deployer '6. Sign-Off (4-Augen)'
  azure_vnet.rule_authoring_subsystem.rule_deployer -> azure_vnet.rules_engine.versioned_rule_repo 'Deployt geprüfte Regeln'

  // --- Stage 5: Circuit Breaker & HITL (Zwei getrennte Auflösungswege!) ---
  azure_vnet.multi_agent_system.orchestrator -> azure_vnet.governance_svc.circuit_breaker 'Prüft Guardrails / Eskalation'
  azure_vnet.governance_svc.circuit_breaker -> azure_vnet.langfuse.otel_pii_gateway 'Loggt Abbruchgrund'
  azure_vnet.governance_svc.circuit_breaker -> azure_vnet.governance_svc.dossier_compiler 'Triggert HITL-Dossier'

  azure_vnet.governance_svc.dossier_compiler -> azure_vnet.data_stores.blob_state 'Liest Bounding-Boxes'
  azure_vnet.governance_svc.dossier_compiler -> azure_vnet.data_stores.cosmos_claims.table_hitl_queue 'Speichert Summary & Highlights'
  azure_vnet.governance_svc.dossier_compiler -> azure_vnet.governance_svc.adjuster_notifier 'Sendet Alert'
  azure_vnet.governance_svc.adjuster_notifier -> adjuster 'Benachrichtigt Spezialist'
  azure_vnet.governance_svc.dossier_compiler -> azure_vnet.governance_svc.adjuster_app 'Übergibt HITL-Dossier'

  adjuster -> azure_vnet.governance_svc.adjuster_app 'Prüft Highlights & entscheidet'
  azure_vnet.governance_svc.adjuster_app -> azure_vnet.data_stores.blob_raw 'Lädt Original mit Highlights'
  azure_vnet.governance_svc.adjuster_app -> azure_vnet.data_stores.cosmos_claims.table_pii_vault 'Löst PII für Anzeige auf'

  // Auflösungsweg 1: Nur bei ungenauer Extraktion (Mid-Flight) -> Zurück zum Agenten
  azure_vnet.governance_svc.adjuster_app -> azure_vnet.multi_agent_system.orchestrator 'Pfad 1 (OCR-Korrektur): Fortsetzen'

  // Auflösungsweg 2: Finale Sachentscheidung (Ablehnung / Großschaden / Betrug) -> KEIN Agent mehr!
  azure_vnet.governance_svc.adjuster_app -> azure_vnet.governance_svc.direct_hitl_executor 'Pfad 2 (Finale Entscheidung): Direkt'
  azure_vnet.governance_svc.direct_hitl_executor -> erp_finance 'Bucht Zahlung direkt'
  azure_vnet.governance_svc.direct_hitl_executor -> azure_vnet.data_stores.sql_pas.table_pas_claims 'Setzt Status SETTLED / DENIED'
  azure_vnet.governance_svc.direct_hitl_executor -> azure_vnet.data_stores.cosmos_claims.table_claim_dossier 'Schließt Dossier'
  azure_vnet.governance_svc.direct_hitl_executor -> channels 'Sendet Entscheidungsbrief'

  // --- Stage 6: Langfuse Observability ---
  azure_vnet.multi_agent_system.orchestrator -> azure_vnet.langfuse.otel_pii_gateway 'OTel-Traces (ohne PII)'
  azure_vnet.governance_svc.adjuster_app -> azure_vnet.langfuse.eval_engine 'Loggt HITL-Override'
  azure_vnet.langfuse.otel_pii_gateway -> azure_vnet.langfuse.langfuse_core 'Speichert Traces & Kosten'
  azure_vnet.langfuse.langfuse_core -> azure_vnet.langfuse.eval_engine 'Trace-Daten für Evals'

  // --- Outcomes ---
  azure_vnet.multi_agent_system.financial_agent -> azure_vnet.claims_outcomes.outcome_stp 'STP-Abschluss'
  azure_vnet.multi_agent_system.customer_agent -> azure_vnet.claims_outcomes.outcome_comm 'Kunden-Dialog'
  azure_vnet.governance_svc.direct_hitl_executor -> azure_vnet.claims_outcomes.outcome_hitl 'HITL-Abschluss'

  // --- Orchestrator State Persistence ---
  azure_vnet.multi_agent_system.orchestrator -> azure_vnet.data_stores.cosmos_claims.table_claim_dossier 'Aktualisiert Workflow-State'
}

// ===========================================================================
// 5. HIERARCHISCHE ANSICHTEN (LEVEL 1 CLEAN OVERVIEW -> LEVEL 2 -> LEVEL 3)
// ===========================================================================
views {

  // -------------------------------------------------------------------------
  // LEVEL 1: AUFGERÄUMTE MANAGEMENT- & ARCHITEKTUR-ÜBERSICHT (CLEAN OVERVIEW)
  // -------------------------------------------------------------------------
  view index {
    title 'Level 1: Gesamtsystem – Clean Architecture Overview'
    description '''
      **Aufgeräumte End-to-End Übersicht (ohne Detail-Überladung):**
      - **Kernfluss (1 &rarr; 2 &rarr; 3 &rarr; 4):** Von `1. Ingestion, Extraction & PII-Tokenization` über `2. Klassifikation & Schadenanlage` in das `3. Multi-Agent Claim Processing System` und bei Bedarf in `4. Circuit Breaker & HITL`.
      - **Kompakte Blöcke mit Drill-Down (Lupe anklicken!):**
        - `Policy Management & Rule Authoring` kapselt die 3 Rollen (Business Analyst, Aktuariat, Risk Manager) und den 4-Augen-Freigabeprozess (Level 2C).
        - `Secured Azure Data & Knowledge Platform` fasst alle 5 Private-Link-Speicher zusammen (inkl. vollständiger **Security- & Data-Privacy-Matrix** beim Anklicken!).
        - `Event Hubs`, `Front Door / APIM` und `Core ERP` liegen sauber in den jeweiligen Subsystemen (Level 2).
    '''

    include
      claimant,
      adjuster,
      channels,
      azure_vnet,
      azure_vnet.extraction_pipeline,
      azure_vnet.classification_pipeline,
      azure_vnet.multi_agent_system,
      azure_vnet.rules_engine,
      azure_vnet.rule_authoring_subsystem,
      azure_vnet.governance_svc,
      azure_vnet.langfuse,
      azure_vnet.data_stores,
      azure_vnet.claims_outcomes,
      azure_vnet.claims_outcomes.*

    autoLayout TopBottom
  }

  // -------------------------------------------------------------------------
  // LEVEL 2A: DRILL-DOWN EXTRAKTIONS- & PII-TOKENIZATION-PIPELINE (INKL. WAF & EVENT HUB)
  // -------------------------------------------------------------------------
  view view_extraction_pipeline of azure_vnet.extraction_pipeline {
    title 'Level 2A: Workflow Ingestion (WAF/Event Hub), Textextraktion & PII-Tokenization'
    description '''
      **Detaillierter Eingangs- & Datenschutz-Workflow:**
      - Zeigt `0a. Azure Front Door & APIM` sowie `0b. Azure Event Hub` (die auf Level 1 bewusst eingeklappt sind).
      - `channel_router` speichert das Original in `blob_raw` und verteilt nach Medientyp.
      - `pii_tokenizer` ersetzt alle PII-Daten durch Platzhalter (`<PII:IBAN_1>`), speichert das echte Mapping im hochgesicherten `table_pii_vault` und legt das pseudonymisierte JSON in `blob_state` ab.
    '''

    include
      channels,
      azure_vnet.extraction_pipeline,
      azure_vnet.extraction_pipeline.*,
      azure_vnet.data_stores.blob_raw,
      azure_vnet.data_stores.blob_state,
      azure_vnet.data_stores.cosmos_claims.table_pii_vault,
      azure_vnet.classification_pipeline.check_preclassified

    autoLayout LeftRight
  }

  // -------------------------------------------------------------------------
  // LEVEL 2B: DRILL-DOWN KLASSIFIKATION & VERTRAGS-AVB-SCHADENANLAGE
  // -------------------------------------------------------------------------
  view view_classification_pipeline of azure_vnet.classification_pipeline {
    title 'Level 2B: Workflow Klassifikation, Historische AVB-Bindung & Schadenanlage'
    description '''
      **Detaillierter Klassifikations- & Anlage-Workflow:**
      - Bei zu niedriger OCR-Konfidenz (`< 0.80`) wird direkt eine Feld-Korrektur im HITL angefordert.
      - Vorklassifizierte Fälle überspringen den `classifier_service`.
      - `pas_claim_creator` ermittelt aus `table_policies` die zum Vertragsabschluss gültige `AvbVersionId`, legt den Schaden deterministisch an und übergibt an den `claims_event_bus`.
    '''

    include
      azure_vnet.extraction_pipeline.pii_tokenizer,
      azure_vnet.classification_pipeline,
      azure_vnet.classification_pipeline.*,
      azure_vnet.governance_svc.dossier_compiler,
      azure_vnet.data_stores.sql_pas.table_policies,
      azure_vnet.data_stores.sql_pas.table_pas_claims,
      azure_vnet.data_stores.cosmos_claims.table_claim_dossier,
      azure_vnet.multi_agent_system.claims_event_bus

    autoLayout LeftRight
  }

  // -------------------------------------------------------------------------
  // LEVEL 2C: DRILL-DOWN POLICY MANAGEMENT (MIT ALLEN 3 ROLLEN & 4-AUGEN-PRINZIP)
  // -------------------------------------------------------------------------
  view view_rule_authoring of azure_vnet.rule_authoring_subsystem {
    title 'Level 2C: Workflow Policy Management – Rollen, Z3-Konfliktanalyse & 4-Augen-Prinzip'
    description '''
      **Hier werden die 3 Fachrollen sichtbar, die auf Level 1 ausgeblendet sind:**
      1. **Intake:** Vertragliche AVBs (`actuary_legal`) oder interne Unternehmensregeln (`business_analyst`).
      2. **DSL-Transformation:** `authoring_agent` erzeugt YAML-DSL und Unit-Tests.
      3. **Konflikt- & Impact-Analyse (`conflict_simulator`):** Prüft per Z3-Solver auf logische Widersprüche und simuliert gegen 10.000 historische Claims aus `table_claim_dossier`.
      4. **4-Augen-Prüfung (`impact_approval_portal`):** Der `risk_compliance_manager` prüft das finanzielle Impact-Delta und gibt die Regel frei.
    '''

    include
      actuary_legal,
      business_analyst,
      risk_compliance_manager,
      azure_vnet.rule_authoring_subsystem,
      azure_vnet.rule_authoring_subsystem.*,
      azure_vnet.rules_engine,
      azure_vnet.rules_engine.*,
      azure_vnet.data_stores.vector_search.table_vector_index,
      azure_vnet.data_stores.cosmos_claims.table_claim_dossier

    autoLayout LeftRight
  }

  // -------------------------------------------------------------------------
  // LEVEL 2D: DRILL-DOWN MULTI-AGENT SYSTEM (INKL. SERVICE BUS, LANGFUSE, STORES & ERP)
  // -------------------------------------------------------------------------
  view view_multi_agent_system of azure_vnet.multi_agent_system {
    title 'Level 2D: Multi-Agent System – Service Bus, Langfuse Prompts, Sub-Agenten & 5 Stores'
    description '''
      **Detailansicht des Multi-Agent-Systems (hier mit aufgeschlüsselten Datenbanken & ERP):**
      - `claims_event_bus` puffert die eingehenden Fälle.
      - `playbook_loader` lädt für die jeweilige Schadensart die Systemprompts, Agenten-Skills und Dokumenten-Checklisten aus `langfuse.prompt_registry`.
      - Klicke auf einen beliebigen der 5 Agenten, um in seine internen MCP-Tools, Critics und Datenbank-Tabellen hineinzuzoomen (Level 3A–3E)!
    '''

    include
      azure_vnet.classification_pipeline.pas_claim_creator,
      azure_vnet.multi_agent_system.claims_event_bus,
      azure_vnet.multi_agent_system.playbook_loader,
      azure_vnet.multi_agent_system.orchestrator,
      azure_vnet.multi_agent_system.customer_agent,
      azure_vnet.multi_agent_system.coverage_agent,
      azure_vnet.multi_agent_system.fraud_agent,
