  breaker: "Sicherheits-Schranke & Sachbearbeiter-Übergabe (HITL)\nStoppt KI bei Ablehnung, Betrugsverdacht, Personenschaden oder Großschaden" { style.fill: "#ffffff"; style.stroke: "#334155" }
  queue -> loader -> orchestrator
  orchestrator -> breaker
}

agents: "Fünf spezialisierte KI-Agenten mit streng getrennten Zugriffsrechten" {
