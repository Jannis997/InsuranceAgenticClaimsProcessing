  view view_adjudication_agent of azure_vnet.multi_agent_system.adjudication_agent {
    title 'Level 3D: Deep-Dive Adjudication Agent – Tarif-Mapping, Coding Critic & Rules Call'
    description '''
      **Interner Aufbau des Adjudication & Pricing Agenten:**
      - `tool_map_items` liest die extrahierten Rechnungspositionen aus `blob_state` und gleicht sie mit Reparatur-Richtlinien in `table_vector_index` ab.
      - `coding_critic` prüft das Tarif-Mapping auf Plausibilität.
      - `tool_exec_rules` ruft die deterministische Rules Engine (`rule_evaluator`) auf und schreibt das Ergebnis in `table_claim_dossier`.
    '''

    include
      azure_vnet.multi_agent_system.orchestrator,
      azure_vnet.multi_agent_system.adjudication_agent,
      azure_vnet.multi_agent_system.adjudication_agent.*,
      azure_vnet.rules_engine.rule_evaluator,
      azure_vnet.data_stores.blob_state,
      azure_vnet.data_stores.vector_search.table_vector_index,
      azure_vnet.data_stores.cosmos_claims.table_claim_dossier

    autoLayout LeftRight
  }

  // -------------------------------------------------------------------------
  // LEVEL 3E: DEEP-DIVE FINANCIAL & SETTLEMENT AGENT
  // -------------------------------------------------------------------------
  view view_financial_agent of azure_vnet.multi_agent_system.financial_agent {
    title 'Level 3E: Deep-Dive Financial Agent – PII-De-Tokenizing, ERP-Payout & Reserve-Sync'
    description '''
      **Interner Aufbau des Financial & Settlement Agenten:**
      - `tool_post_payment` löst das Token `<PII:IBAN_1>` über `table_pii_vault` in die echte IBAN auf und führt die Auszahlung im `erp_finance` aus.
      - `tool_update_reserve` aktualisiert die Rückstellungen und schließt die Schadenakte in `table_claim_dossier` und `table_pas_claims`.
    '''

    include
      erp_finance,
      azure_vnet.multi_agent_system.orchestrator,
      azure_vnet.multi_agent_system.financial_agent,
      azure_vnet.multi_agent_system.financial_agent.*,
      azure_vnet.data_stores.cosmos_claims.table_pii_vault,
      azure_vnet.data_stores.cosmos_claims.table_claim_dossier,
      azure_vnet.data_stores.sql_pas.table_pas_claims,
      azure_vnet.claims_outcomes.outcome_stp

    autoLayout LeftRight
  }

  // -------------------------------------------------------------------------
  // LEVEL 3F: DRILL-DOWN IN ALLE 5 DATENBANKEN, SCHEMATA & SECURITY/PRIVACY
  // -------------------------------------------------------------------------
  view view_database_schemas of azure_vnet.data_stores {
    title 'Level 3F: Detailansicht der 5 Enterprise Data Stores, Private Link & Schemata'
    description '''
      **Vollständige Datenbank-, Security- & Schema-Übersicht:**
      - Hier sind alle 5 Speicher einzeln aufgefächert (die auf Level 1 für die Übersichtlichkeit zu einer Plattform-Box zusammengefasst sind).
      - Enthält `Azure Key Vault & Private Link DNS` sowie den `pii_token_vault`.
      - Klicke auf ein beliebiges Element, um rechts im Inspektor die Markdown-Tabellen und Privacy-Klassifizierungen zu sehen!
    '''

    include
      azure_vnet.data_stores.security_vault,
      azure_vnet.data_stores.blob_raw,
      azure_vnet.data_stores.blob_state,
      azure_vnet.data_stores.cosmos_claims,
      azure_vnet.data_stores.cosmos_claims.*,
      azure_vnet.data_stores.vector_search,
      azure_vnet.data_stores.vector_search.*,
      azure_vnet.data_stores.sql_pas,
      azure_vnet.data_stores.sql_pas.*,
      azure_vnet.data_stores.databricks_lakehouse,
      azure_vnet.data_stores.databricks_lakehouse.*

    autoLayout TopBottom
  }

  // -------------------------------------------------------------------------
  // LEVEL 3G: DEEP-DIVE AZURE AI SEARCH & FOUNDRY IQ (INDEXER, HYBRID & RERANKER)
  // -------------------------------------------------------------------------
  view view_ai_search_pipeline of azure_vnet.data_stores.vector_search {
    title 'Level 3G: Deep-Dive Azure AI Search & Foundry IQ – Indexer Skillset, Hybrid RRF & L2 Semantic Reranker'
    description '''
      **Detailarchitektur der Wissensbasis (`policy-knowledge`) & Evaluation-Verbindung:**
      1. **Ingestion & Integrated Vectorization (`search_indexer`):** Nutzt den `Document Intelligence Layout Skill` für tabellen- und paragraphentreues Chunking + `text-embedding-3-large` (3072 dims).
      2. **Pre-Filtered Hybrid Search (`table_vector_index`):** Filtert strikt auf `avbVersionId` und kombiniert BM25 (exakte Paragraphen/Tarifcodes) mit HNSW-Vektorsuche.
      3. **RRF & L2 Semantic Reranker (`semantic_reranker`):** Fusioniert Top-50 Treffer per Reciprocal Rank Fusion und bewertet sie mit dem Cross-Encoder (`@search.rerankerScore >= 2.2`) inkl. Extractive Captions.
      4. **RAG-Evaluation (`eval_engine`):** Prüft kontinuierlich Context Relevance, NDCG@3 und Groundedness gegen die abgerufenen Chunks.
    '''

    include
      azure_vnet.rule_authoring_subsystem.avb_intake,
      azure_vnet.data_stores.vector_search,
      azure_vnet.data_stores.vector_search.*,
      azure_vnet.multi_agent_system.coverage_agent.tool_search_clauses,
      azure_vnet.multi_agent_system.adjudication_agent.tool_map_items,
      azure_vnet.multi_agent_system.customer_agent.tool_gen_eob,
      azure_vnet.langfuse.eval_engine

    autoLayout LeftRight
  }

  // -------------------------------------------------------------------------
  // LEVEL 3H: DEEP-DIVE AZURE DATABRICKS LAKEHOUSE & MOSAIC AI
  // -------------------------------------------------------------------------
  view view_databricks_lakehouse of azure_vnet.data_stores.databricks_lakehouse {
    title 'Level 3H: Deep-Dive Azure Databricks Lakehouse – Mass-Backtesting, Fraud-Graph & Solvency II'
    description '''
      **Warum Azure Databricks die operative Echtzeit-Architektur ergänzt (Analytical & ML Plane):**
      1. **Zero-ETL Change Data Feed (`unity_catalog_delta`):** Synchronisiert pseudonymisierte Schadenakten aus Cosmos DB und Bestandsdaten aus Azure SQL ohne Last auf den operativen Systemen.
      2. **Spark & Photon Mass-Backtesting (`spark_photon_backtester`):** Simuliert neue Regeln aus dem `conflict_simulator` (Level 2C) gegen 500.000+ historische Claims in Sekunden.
      3. **GraphFrames & Mosaic AI (`mosaic_fraud_ml`):** Erkennt organisierte Betrugsringe über Werkstätten, Gutachter und Anspruchsteller hinweg und liefert Echtzeit-Scores an `tool_score_anomaly` (Level 3C).
      4. **Golden Datasets & Solvency II:** Empfängt kuratierte HITL-Overrides aus der `eval_engine` (Level 2F) und berechnet aktuarische Schadenentwicklungsdreiecke (IBNR).
    '''

    include
      azure_vnet.data_stores.cosmos_claims.table_claim_dossier,
      azure_vnet.data_stores.sql_pas.table_pas_claims,
      azure_vnet.rule_authoring_subsystem.conflict_simulator,
      azure_vnet.multi_agent_system.fraud_agent.tool_score_anomaly,
      azure_vnet.langfuse.eval_engine,
      azure_vnet.data_stores.databricks_lakehouse,
      azure_vnet.data_stores.databricks_lakehouse.*

    autoLayout LeftRight
  }
}
