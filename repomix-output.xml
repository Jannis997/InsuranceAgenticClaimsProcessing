  style.stroke: "#0284c7"
  a1: "A1. Kundenkommunikation\n• Prüft Dokumenten-Checkliste\n• Erstellt Abrechnungsschreiben\n• Interne Qualitätskontrolle vor Versand" { style.fill: "#f8fafc"; style.stroke: "#334155" }
