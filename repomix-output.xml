  // -------------------------------------------------------------------------
  // LEVEL 2E: DRILL-DOWN CIRCUIT BREAKER & HITL (ZWEI AUFLÖSUNGSWEGE)
  // -------------------------------------------------------------------------
  view view_governance_hitl of azure_vnet.governance_svc {
    title 'Level 2E: Workflow Circuit Breaker, Highlighting & Die 2 HITL-Auflösungswege'
    description '''
      **Präzise Trennung nach der Sachbearbeiter-Entscheidung in der `adjuster_app`:**
      - **Pfad 1 (Reine OCR-/Daten-Bestätigung bei Low Confidence):** Der Sachbearbeiter bestätigt lediglich den markierten Wert -> Rückgabe an den `orchestrator`, damit die Agenten den Fall normal zu Ende führen.
      - **Pfad 2 (Finale Sachentscheidung: Ablehnung, Großschaden, Betrug):** Es geht **NICHT** zurück an den Agenten! Der `direct_hitl_executor` führt die Entscheidung deterministisch aus (ERP-Zahlung, Status-Update, Versand des Ablehnungs-/Entscheidungsschreibens).
    '''

    include
      adjuster,
      channels,
      erp_finance,
      azure_vnet.multi_agent_system.orchestrator,
      azure_vnet.governance_svc,
      azure_vnet.governance_svc.*,
      azure_vnet.langfuse.otel_pii_gateway,
      azure_vnet.langfuse.eval_engine,
      azure_vnet.data_stores.blob_raw,
      azure_vnet.data_stores.blob_state,
