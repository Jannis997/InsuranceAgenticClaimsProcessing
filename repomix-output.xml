          summary 'De-tokenisiert Empfängerdaten (<PII:NAME_1>) über den PII-Vault & versendet Nachricht'
        }

        tool_gen_eob = mcp_tool 'MCP: generate_eob_letter' {
          #mcp #versioning #pii_protected
          summary 'Holt AVB-Originalzitate aus AI Search, de-tokenisiert PII & rendert das PDF-Schreiben'
