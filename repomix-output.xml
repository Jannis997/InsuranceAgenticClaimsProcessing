  // LEVEL 3H: DEEP-DIVE AZURE DATABRICKS LAKEHOUSE & MOSAIC AI
  // -------------------------------------------------------------------------
  view view_databricks_lakehouse of azure_vnet.data_stores.databricks_lakehouse {
    title 'Level 3H: Deep-Dive Azure Databricks Lakehouse – Mass-Backtesting, Fraud-Graph & Solvency II'
    description '''
      **Warum Azure Databricks die operative Echtzeit-Architektur ergänzt (Analytical & ML Plane):**
      1. **Zero-ETL Change Data Feed (`unity_catalog_delta`):** Synchronisiert pseudonymisierte Schadenakten aus Cosmos DB und Bestandsdaten aus Azure SQL ohne Last auf den operativen Systemen.
      2. **Spark & Photon Mass-Backtesting (`spark_photon_backtester`):** Simuliert neue Regeln aus dem `conflict_simulator` (Level 2C) gegen 500.000+ historische Claims in Sekunden.
      3. **GraphFrames & Mosaic AI (`mosaic_fraud_ml`):** Erkennt organisierte Betrugsringe über Werkstätten, Gutachter und Anspruchsteller hinweg und liefert Echtzeit-Scores an `tool_score_anomaly` (Level 3C).
      4. **Golden Datasets & Solvency II:** Empfängt kuratierte HITL-Overrides aus der `eval_engine` (Level 2F) und berechnet aktuarische Schadenentwicklungsdreiecke (IBNR).
    '''

    include
      azure_vnet.data_stores.cosmos_claims.table_claim_dossier,
      azure_vnet.data_stores.sql_pas.table_pas_claims,
      azure_vnet.rule_authoring_subsystem.conflict_simulator,
      azure_vnet.multi_agent_system.fraud_agent.tool_score_anomaly,
      azure_vnet.langfuse.eval_engine,
      azure_vnet.data_stores.databricks_lakehouse,
      azure_vnet.data_stores.databricks_lakehouse.*

    autoLayout LeftRight
  }
