model {

  // =========================================================================
  // 1. EXTERNAL ACTORS & ENTRY CHANNELS
  // =========================================================================
  claimant = actor 'Versicherungsnehmer (Claimant)' {
    summary 'Meldet Schaden, reicht schadensartspezifische Belege nach & erhält EOB'
    icon bootstrap:person
  }

  adjuster = actor 'Spezial-Sachbearbeiter (HITL)' {
    #hitl
    summary 'Prüft eskalierte Fälle in der HITL-App (mit Highlighting & KI-Vorarbeit)'
    icon bootstrap:headset
  }

  // Diese 3 Rollen werden erst im Drill-Down von Policy Management (Level 2C) eingeblendet
  business_analyst = actor 'Business Analyst (Fachbereich)' {
    summary 'Erstellt interne Unternehmens- & Prozessregeln in natürlicher Sprache'
    icon bootstrap:person-gear
  }

  actuary_legal = actor 'Produktmanagement & Aktuariat (Legal)' {
    #versioning
    summary 'Veröffentlicht neue vertragliche AVB-Generationen & Tarifwerke'
    icon bootstrap:bank
  }

  risk_compliance_manager = actor 'Risk & Governance Manager (2. Prüfer)' {
    #security #versioning
    summary '4-Augen-Prinzip: Prüft Backtest-Impact & gibt neue Regeln für Produktion frei'
    icon bootstrap:person-check-fill
  }

  channels = channel 'Omnichannel Frontend & IVR' {
    summary 'Webportal (teilw. vorklassifiziert), App, E-Mail, Chat & Telefon (IVR)'
    icon bootstrap:window-stack
  }

  // =========================================================================
  // 2. ISOLATED AZURE VNET (SECURITY PERIMETER)
  // =========================================================================
  azure_vnet = vnet 'Azure Virtual Network (Isolated Spoke – Zero Public Access)' {
    #security #private_endpoint
    icon bootstrap:diagram-3
    description '''
      ### Enterprise Security & Network Perimeter
      | Sicherheits-Aspekt | Umsetzung in Azure |
      | :--- | :--- |
      | **Netzwerk-Isolation** | Dediziertes Spoke-VNet (`10.42.0.0/16`) mit NSGs & Azure Firewall Egress-Filtering |
      | **Private Endpoints** | Alle 6 Data & Analytics Stores, Event Hubs, AI Foundry & Langfuse sind **ausschließlich** über `Azure Private Link` erreichbar (`publicNetworkAccess: Disabled`) |
      | **Authentifizierung (IAM)** | System-Assigned **Managed Identities** (Entra ID RBAC) für jeden Agenten und Service – keinerlei Passwörter oder API-Keys im Code |
      | **Verschlüsselung** | TLS 1.3 in Transit + Customer-Managed Keys (CMK) in Azure Key Vault at Rest |
      | **Data Residency & AI Privacy**| EU Data Boundary (Germany West Central / Sweden Central), Zero Data Retention bei Azure AI Services (kein Microsoft-Modelltraining) |
    '''
    metadata {
      private_link_enforced 'true (Azure Policy: Deny Public Network Access)'
      encryption_at_rest 'Customer-Managed Keys (Azure Key Vault HSM)'
      ai_data_governance 'EU Data Boundary + Abuse Monitoring Opt-Out (Zero Retention)'
    }

    // -----------------------------------------------------------------------
    // A. INGESTION, EXTRAKTION & PII-TOKENIZATION (INKL. GATEWAY & EVENT HUB)
    // -----------------------------------------------------------------------
    extraction_pipeline = pipeline '1. Ingestion, Extraction & PII-Tokenization' {
      #pii_protected #security
      summary 'Foundry Tools Pipeline: Content Understanding (2025-11-01 GA / Agentic Mode), Doc Intel v4.0, MAI-Transcribe-2, Text Analytics for Health & PII'
      icon bootstrap:file-earmark-text
      description '''
        **Kombiniert alle 6 spezialisierten Foundry Tools (Stand 2026) in einer revisionssicheren Pipeline:**
        0. **Edge Security & Event Hub (intern):** WAF/APIM (AI Gateway + Verified Reverse Proxy für Face Liveness) prüft Auth-Token; `Azure Event Hub` puffert Lastspitzen.
        1. **Modality Router:** Archiviert sofort das unveränderte Original in `blob_raw` (WORM).
        2. **Hybride Spezial-Extraktion (Foundry Tools):**
           - **Content Understanding (`2025-11-01` GA / `2026-06-01-preview`):** Nutzt `enableSegment: true` & `allowInPageSegments: true` zur automatischen Dokumenten-Trennung (z.B. Rechnung + Ausweis + Polizeibericht in einem PDF), `estimateFieldSourceAndConfidence: true` für Source-Grounding `D(page,x1,y1..)` und `workflow: "agentic"` für komplexe Mehr-Dokumenten-Abgleiche.
           - **Document Intelligence v4.0 (`2024-11-30` GA):** Spezialisierte Extraktion für `prebuilt-invoice`, `prebuilt-idDocument` und `Custom Neural v4.0` (mit Table/Row/Cell-Confidence, Signature Detection, `queryFields` & HTML-Tabellen mit `rowspan`/`colspan`).
           - **Speech (`MAI-Transcribe-2` & `Voice Live 2026-01-01-preview`):** Telefon-IVR über `Voice Live` (`azure_semantic_vad_multilingual`, `End-of-Utterance Detection`, `auto_truncate`, `LlmInterimResponseConfig`, `MAI-Voice-2.1-Flash`) sowie Fast Transcription mit Diarization (`maxSpeakers`, `phraseList` für Versicherungsvokabular).
           - **Vision & Azure Face (`detection_03` / `recognition_04`):** Schadensfoto-Analyse, **DSGVO-konformes Face-Blurring** unbeteiligter Dritter (`returnFaceId: false`) und optionale **iBeta Level 1/2 Face Liveness Verification** (`detectLivenessWithVerify/singleModal` + `deviceCorrelationId`).
        3. **Sprach-, Medizin- & Übersetzungs-Pipeline:**
           - **Azure AI Language (`2026-05-01` GA):** `Language Detection` (inkl. `scriptCode` & `countryHint`), **Text Analytics for Health** (für Personenschäden: ICD-10/UMLS Entity Linking, `Assertion Detection` für Vorerkrankungen `temporal: past` vs. `current` & **HL7 FHIR v4.0.1 Bundle**) sowie **PII Detection** (Text, Conversation mit Audio-Timing & Document-PII; Kategorien inkl. `IBAN`, `VIN`, `LicensePlate`, `DriversLicenseNumber`, `valueExclusionPolicy` für Partnerwerkstätten & `loggingOptOut=true`).
           - **Azure AI Translator (`2026-06-06` Text GA & `2026-03-01` Document GA):** Layout-erhaltende PDF-Dokumentenübersetzung (mit Document Intelligence & TSV-Glossaren) sowie NMT / Adaptive Custom Translation (`adaptiveDatasetId`).
        4. **PII-Tokenization & Assembly:** Ersetzt PII konsistent durch Tokens (`<PII:IBAN_1>`, `<PII:VIN_1>`), speichert das Mapping im `table_pii_vault` und legt `canonical-claim.json` in `blob_state` ab.
      '''

      front_door_apim = gateway '0a. Azure Front Door (WAF) & APIM AI Gateway' {
        #security #private_endpoint
        summary 'DDoS-Schutz, OWASP-WAF, TLS 1.3, Entra ID Kunden-AuthZ, Token-Rate-Limiting & Face Liveness Reverse Proxy'
        icon bootstrap:shield-lock
      }

      ingestion_event_hub = queue_bus '0b. Azure Event Hub: Raw Ingestion & DLQ' {
        #private_endpoint
        summary 'Puffert eingehende Multi-Channel Payloads vor der Textextraktion (inkl. Dead-Letter Queue)'
        icon bootstrap:inbox-fill
        metadata {
          sku 'Premium Event Hub / Service Bus'
          retention '7 Days'
          dead_letter 'dlq-raw-ingestion'
        }
      }

      channel_router = compute '1. Input Modality Router & Archiver' {
        summary 'Speichert Original in blob_raw & routet nach Dateityp (Audio, PDF/DOCX, Bild, Text)'
        icon bootstrap:signpost-split
      }
      speech_svc = ai_service '2a. Azure Speech (MAI-Transcribe-2 & Voice Live Agent)' {
        summary 'IVR Voice Live (Semantic VAD, EOU, Interim Responses, MAI-Voice-2.1-Flash) & Fast Transcription (Diarization + PhraseList)'
        icon bootstrap:mic
        metadata {
          transcription 'MAI-Transcribe-2 (60 langs, word timestamps, diarization, phraseList), MAI-Transcribe-2-Streaming'
          voice_live 'Voice Live API (2026-01-01-preview): azure_semantic_vad_multilingual, EOU, auto_truncate, LlmInterimResponseConfig'
          synthesis 'MAI-Voice-2.1-Flash & DragonHDLatestNeural (SSML, paralinguistics)'
        }
      }
      doc_intel = ai_service '2b. Content Understanding & Document Intelligence v4.0' {
        summary 'Auto-Segmentation (inkl. In-Page), Agentic Mode, Prebuilt-Invoice & Custom Neural v4.0 (Cell Confidence, Signatures, Polygons)'
        icon bootstrap:file-earmark-text
        metadata {
          content_understanding 'API 2025-11-01 GA / 2026-06-01-preview: enableSegment, allowInPageSegments, estimateFieldSourceAndConfidence, workflow=agentic'
          document_intelligence 'API v4.0 (2024-11-30 GA): prebuilt-invoice, prebuilt-idDocument, Custom Neural (table/row/cell confidence, signatures, queryFields)'
          outputs 'Markdown + HTML Tables (rowspan/colspan), Field Confidence [0..1], Source Grounding D(page,x1,y1..)'
        }
      }
      vision_svc = ai_service '2c. Azure Vision & Face (Damage Analysis, Face Blur & Liveness)' {
        summary 'Prüft Schadensfotos, verpixelt Gesichter Dritter (detection_03) & prüft Identität via ISO-30107-3 Face Liveness (recognition_04)'
        icon bootstrap:camera
        metadata {
          privacy_redaction 'Face Detect (detection_03, returnFaceId=false) für DSGVO-Gesichtsverpixelung auf Unfallfotos'
          kyc_anti_spoofing 'DetectLivenessWithVerify (iBeta Level 1/2 0% PAD, recognition_04, deviceCorrelationId Abuse Monitoring)'
        }
      }
      lang_svc = ai_service '3a. Azure AI Language (PII 2026-05-01, Health FHIR & NER)' {
        #pii_protected
        summary 'Erkennt 50+ PII-Typen (IBAN, VIN, KFZ), analysiert Arztbriefe (Text Analytics for Health -> FHIR v4.0.1 & Assertions) & Sprache'
        icon bootstrap:translate
        metadata {
          pii_detection 'API 2026-05-01 GA: Text, Conversation (includeAudioRedaction) & Document PII; entitySynonyms, valueExclusionPolicy, loggingOptOut=true'
          health_analytics 'Text Analytics for Health: UMLS/ICD-10 Linking, Assertion Detection (certainty=negative, temporal=past vs current), FHIR 4.0.1 Bundle'
          mcp_integration 'Remote/Local Azure Language MCP Server (/language/mcp?api-version=2025-11-15-preview)'
        }
      }
      translator_svc = ai_service '3b. Azure AI Translator (Text 2026-06-06 & Doc 2026-03-01 GA)' {
        summary 'Übersetzt Auslands-Belege layouttreu (Document Translation + Doc Intel + TSV-Glossar) & Text (NMT / AdaptCT)'
        icon bootstrap:globe
        metadata {
          text_api 'API 2026-06-06 GA: NMT (Private Endpoint kompatibel) & Adaptive Custom Translation (adaptiveDatasetId, tone=formal)'
          doc_api 'API 2026-03-01 GA: Sync/Batch Document Translation mit Document Intelligence Layout-Erhalt, Bild-Übersetzung & Fachglossar'
          privacy 'Strict No-Trace Policy (Zero Data Retention)'
        }
      }
      pii_tokenizer = compute '4. PII Tokenizer, Quality Gate & Canonical Assembler' {
        #pii_protected #security
        summary 'Prüft Beleglesbarkeit (OCR-Konfidenz), ersetzt PII durch Tokens (<PII:IBAN_1>), speichert Mapping im Vault & JSON in blob_state'
        icon bootstrap:key-fill
      }
    }

    // -----------------------------------------------------------------------
    // B. KLASSIFIKATION & DETERMINISTISCHE SCHADENANLAGE
    // -----------------------------------------------------------------------
    classification_pipeline = pipeline '2. Klassifikation & Deterministische Schadenanlage' {
      summary 'Klassifiziert Schadensart & Schwere via Microsoft-Decision-1 (SystemOne API), bindet historische AVB & legt Schaden im PAS an'
      icon bootstrap:check-circle
      description '''
        **Workflow nach der Informationsextraktion:**
        - Wurde bereits bei der Extraktion eine unzureichende Beleglesbarkeit (`< 0.80`) festgestellt, leitet die Eingangs-Weiche den Beleg zur kurzen Datenbestätigung an das HITL-System.
        - Ist die Meldung bereits aus dem Portal vorklassifiziert, wird die KI-Klassifikation übersprungen.
        - Unstrukturierte Eingänge werden über **`Microsoft-Decision-1` (`/providers/microsoft/v1/systemone`)** typisiert klassifiziert:
          - `choice`: Exakte Schadensart (`AUTO_GLASS`, `WATER_DAMAGE`, `BODILY_INJURY`) + Wahrscheinlichkeitsverteilung.
          - `score`: Geordnete Schaden-Schwere (`Cosmetic`, `Minor`, `Major`, `Critical`).
          - `noul`: Binäres Gate für Personenschaden / Anwaltsschreiben (`0.0 - 1.0`).
        - Für authentifizierte Kunden wird deterministisch der Vertrag geprüft, die **zum Vertragsabschluss gültige AVB-Generation (`AvbVersionId`)** ermittelt und die Schadenakte angelegt.
      '''

      check_preclassified = compute '1. Eingangs- & Vor-Klassifikations-Weiche' {
        summary 'Leitet unleserliche Belege (<0.80) an HITL & prüft, ob Schadensart bereits durch Portal bekannt ist'
        icon bootstrap:signpost-2
      }
      classifier_service = ai_service '2. Microsoft-Decision-1 Classifier (SystemOne API)' {
        summary 'Deterministisch strukturierte Entscheidung (choice: Schadensart, score: Schwere, noul: BI-Gate) mit Kalibrierung'
        icon bootstrap:tags
        metadata {
          endpoint '/providers/microsoft/v1/systemone (Microsoft-Decision-1)'
          primitives 'choice (claimType), score (severity 0..3), noul (bodilyInjuryGate)'
        }
      }
      pas_claim_creator = compute '3. Deterministische Schadenanlage & AVB-Bindung' {
        #deterministic #versioning
        summary 'Prüft Kunden-Auth, liest historische AvbVersionId des Vertrags & legt Schadenakte an'
        icon bootstrap:journal-plus
      }
    }

    // -----------------------------------------------------------------------
    // C. MULTI-AGENT CLAIM PROCESSING SYSTEM (INKL. CLAIMS SERVICE BUS)
    // -----------------------------------------------------------------------
    multi_agent_system = pipeline '3. Multi-Agent Claim Processing System' {
      summary 'Foundry Hosted Agents (Responses API v1, Model Router, Toolbox MCP & Foundry Guardrails/Prompt Shields)'
      icon bootstrap:robot
      description '''
        **Microsoft Foundry Agent Service (2026 Reference Architecture):**
        0. **Azure Service Bus Queue (intern):** Entkoppelt und puffert angelegte Schadenfälle (`session_enabled: claimId`).
        1. **Foundry Hosted Agents (Responses Protocol `2.0.0`):** Laufen in isolierten Micro-VM-Sandboxes mit dedizierter **Microsoft Entra Agent Identity** je Agent und `FoundryToolbox` MCP-Anbindung.
        2. **Foundry Model Router (`2025-11-18`) & PTU Spillover:**
           - `router-frontier` (`Quality`-Mode: `gpt-6-sol`, `gpt-5.6-sol`, `claude-sonnet-5`) für Orchestrator, Coverage & Critics.
           - `router-balanced` (`Balanced`-Mode: `gpt-5.4-mini`, `gpt-5.6-luna`) für Standard-Tool-Calls.
           - Nutzt **Prompt Caching Breakpoints** für AVB-Kontexte und **PTU Traffic Spillover** (`DataZoneProvisionedManaged` &rarr; `DataZoneStandard`).
        3. **Foundry Guardrails an 4 Intervention Points (`User Input`, `Tool Call`, `Tool Response`, `Output`):**
           - **Prompt Shields & Spotlighting:** Schutz gegen indirekte Prompt-Injections (XPIA) in hochgeladenen PDFs/Rechnungen.
           - **Groundedness Detection & Task Adherence:** Verhindert Halluzinationen und Abweichungen vom Schadensart-Playbook.
      '''

      claims_event_bus = queue_bus '0. Azure Service Bus: Claims Processing Queue' {
        #private_endpoint
        summary 'Puffert angelegte Schäden nach Schadensart & Priorität für die Agenten-Verarbeitung'
        icon bootstrap:hdd-stack
        metadata {
          queue_name 'claims-processing-queue'
          session_enabled 'true (claimId)'
        }
      }

      playbook_loader = compute '1. Claim-Type Playbook & Skill Loader' {
        summary 'Lädt je Schadensart die Dokumenten-Checkliste, Agenten-Skills & Systemprompts aus Langfuse'
        icon bootstrap:list-check
      }

      orchestrator = orchestrator '2. Magentic Claims Orchestrator' {
        summary 'Zentrales Gehirn: Steuert Sub-Agenten nach Schadensart-Playbook & kann aktiv an HITL eskalieren'
        icon bootstrap:cpu-fill
        metadata {
          pattern 'Magentic Orchestrator + Self-Escalation Capability'
          prompt_source 'Langfuse Prompt Registry (by claimType)'
        }
      }

      // --- AGENT 1: CUSTOMER COMMUNICATION & INTAKE ---
      customer_agent = agent 'Customer Communication & Intake Agent' {
        #critic_pattern
        summary 'Einziger Agent mit Kundenkontakt: Nutzt Generator-Critic für rechtssichere EOBs & Rückfragen'
        icon bootstrap:chat-dots-fill

        comm_critic = critic 'Internal Compliance & Groundedness Critic' {
          #critic_pattern
          summary 'Prüft EOB-Entwürfe auf Halluzinationsfreiheit, korrekte AVB-Zitate & Tonalität vor Versand'
          icon bootstrap:person-badge
        }

        tool_request_docs = mcp_tool 'MCP: request_checklist_documents' {
          #mcp
