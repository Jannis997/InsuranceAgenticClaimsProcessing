# Multi-Agent System Overview - English (Paste into https://play.d2lang.com)
direction: down

vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 1
  }
}

control: "Process Control & Safety Guardrails" {
  style.fill: "#f8fafc"
  style.stroke: "#cbd5e1"
  queue: "0. Processing Queue\nOrdered Case Handover" { style.fill: "#ffffff"; style.stroke: "#334155" }
  loader: "1. Claim-Type Preparation\nLoads Review Plan & Checklist" { style.fill: "#ffffff"; style.stroke: "#334155" }
  orchestrator: "2. Central Claims Orchestrator (Process Control)\nCoordinates all 5 specialized agents, blocks manipulation & pauses workflows during customer inquiries" { style.fill: "#f8fafc"; style.stroke: "#0284c7"; style.bold: true }
  breaker: "Safety Guardrail & Human Handover (HITL)\nStops AI on potential rejection, fraud suspicion, bodily injury, or high-value claims" { style.fill: "#ffffff"; style.stroke: "#334155" }
  queue -> loader -> orchestrator
  orchestrator -> breaker
}

agents: "Five Specialized AI Agents with Strictly Segregated Access Rights" {
  style.fill: "#ffffff"
  style.stroke: "#0284c7"
  a1: "A1. Customer Communication\n• Checks Document Completeness\n• Drafts Settlement Letters\n• Internal Quality & Citation Check" { style.fill: "#f8fafc"; style.stroke: "#334155" }
  a2: "A2. Coverage Pre-Check\n• Matches Cause of Loss to Policy Terms\n• Structures Contract Facts for the\n  Binding Calculation Engine" { style.fill: "#f8fafc"; style.stroke: "#334155" }
  a3: "A3. Fraud & Risk Review\n• Checks Photos for Duplicates\n• Queries Fraud Network Score\n  in Azure Databricks" { style.fill: "#f8fafc"; style.stroke: "#334155" }
  a4: "A4. Invoice & Line-Item Review\n• Maps Free-Text Invoice Lines to\n  Standardized Repair & Service Items\n• Hands Over to Calculation Engine" { style.fill: "#f8fafc"; style.stroke: "#334155" }
  a5: "A5. Payout & Accounting\n• Updates Claim Reserves\n• Triggers SEPA Payout upon\n  Unambiguous STP Approval" { style.fill: "#f8fafc"; style.stroke: "#334155" }
}

backends: "Dedicated Systems & Queries per Agent (1:1 Alignment)" {
  style.fill: "#f1f5f9"
  style.stroke: "#1e293b"
  b1: "Claim File, Policy Search & Vault\n• Reads Open Checklist from Claim File\n• Pulls Clause Citations (Azure AI Search)\n• Resolves Address Only Upon Dispatch" { style.fill: "#ffffff"; style.stroke: "#334155" }
  b2: "Policy System & Terms Knowledge Base\n• Reads Policy Status & Coverages (SQL)\n• Searches Coverage & Exclusion Clauses\n  in Applicable Policy Generation (AI Search)" { style.fill: "#ffffff"; style.stroke: "#334155" }
  b3: "Image Archive, Policy DB & Databricks\n• Checks Photo Fingerprints in Archive\n• Reads Prior Claims History (SQL)\n• Computes Real-Time Fraud Network Score" { style.fill: "#ffffff"; style.stroke: "#334155" }
  b4: "Repair Guidelines & Calculation Engine\n• Matches Repair & Service Guidelines\n• Passes Standardized Items to Engine\n• Receives Exact Binding Payout Amount" { style.fill: "#ffffff"; style.stroke: "#334155" }
  b5: "Privacy Vault, Policy DB & SAP\n• Resolves IBAN in Privacy Vault\n• Executes SEPA Bank Transfer in SAP\n• Updates Reserve & Closes Claim File" { style.fill: "#ffffff"; style.stroke: "#334155" }
}

control.orchestrator -> agents.a1 -> backends.b1
control.orchestrator -> agents.a2 -> backends.b2
control.orchestrator -> agents.a3 -> backends.b3
control.orchestrator -> agents.a4 -> backends.b4
control.orchestrator -> agents.a5 -> backends.b5
</file>

