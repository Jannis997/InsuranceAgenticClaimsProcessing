}

vnet: "Secured Azure Cloud Environment (Zero Public Internet Access / 100% Private Network Connectivity)" {
  style.fill: "#ffffff"
  style.stroke: "#0284c7"
  style.stroke-dash: 5

  flow: "Operational Claims Processing Chain" {
    style.stroke: transparent
    style.fill: transparent
    step1: "1. Ingestion & Data Privacy\n• Structured AI Information Extraction\n• Original Archive & Readability Check\n• Early Anonymization of Personal Data" { class: accent }
    step2: "2. Classification & Claim Setup\n• Categorization by Claim Type & Severity\n• Customer & Policy Master Data Match\n• Binding Claim Creation in Core System" { class: accent }
    step3: "3. Multi-Agent Claim Review\n• Central Coordination via Orchestrator\n• 5 Specialized Agents & Internal Critics" { class: accent }
    monitoring: "AI Quality & Monitoring\n• Privacy-Safe Audit Logging\n• Continuous Quality Evaluation" { class: card }
    step1 -> step2 -> step3
    step3 <-> monitoring
  }

  foundation: "Data Platform, Rules Runtime & Escalation" {
    style.stroke: transparent
    style.fill: transparent
    data: "Central Data, Knowledge & Analytics Platform (Azure & Databricks)\n• Audit-Proof Original Archive, Operational Claim File & Isolated Privacy Vault\n• Policy Admin System (SQL), Policy Knowledge Base & Databricks Fraud/Simulation Analytics" { class: platform }
    rules: "Deterministic Calculation Engine\n• Binding Limit, Cap & Deductible Math" { class: card }
    policy: "Policy Management (4-Eyes)\n• Business Authoring, Simulation & Sign-Off" { class: card }
    hitl: "4. Safety Guardrails & Human Review (HITL)\n• No Automated Rejection (GDPR Art. 22)\n• Prepared Case File with Source Highlights" { class: card }
    outcomes: "Defined Claims Processing Outcomes\n1. Dark Processing (STP) | 2. Customer Dialogue Loop | 3. Specialist Resolution (HITL)" { class: platform }
    policy -> rules
    hitl -> outcomes
  }

  flow.step1 -> foundation.data
  flow.step2 -> foundation.data
  flow.step3 <-> foundation.data
  flow.step3 <-> foundation.rules
  flow.step3 -> foundation.hitl
  flow.step3 -> foundation.outcomes
}

entry.channels -> vnet.flow.step1
vnet.foundation.hitl <-> entry.adjuster
