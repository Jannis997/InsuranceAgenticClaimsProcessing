      azure_vnet.claims_outcomes.outcome_stp

    autoLayout LeftRight
  }

  // -------------------------------------------------------------------------
  // LEVEL 3F: DRILL-DOWN IN ALLE 5 DATENBANKEN, SCHEMATA & SECURITY/PRIVACY
  // -------------------------------------------------------------------------
  view view_database_schemas of azure_vnet.data_stores {
