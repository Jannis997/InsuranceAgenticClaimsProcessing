  a5: "A5. Auszahlung & Buchung\n• Bucht Schadenrückstellungen\n• Stößt SEPA-Auszahlung bei\n  eindeutiger Freigabe an" { style.fill: "#f8fafc"; style.stroke: "#334155" }
