  // -------------------------------------------------------------------------
  // LEVEL 3G: DEEP-DIVE AZURE AI SEARCH & FOUNDRY IQ (INDEXER, HYBRID & RERANKER)
  // -------------------------------------------------------------------------
  view view_ai_search_pipeline of azure_vnet.data_stores.vector_search {
    title 'Level 3G: Deep-Dive Azure AI Search & Foundry IQ – Indexer Skillset, Hybrid RRF & L2 Semantic Reranker'
    description '''
      **Detailarchitektur der Wissensbasis (`policy-knowledge`) & Evaluation-Verbindung:**
      1. **Ingestion & Integrated Vectorization (`search_indexer`):** Nutzt den `Document Intelligence Layout Skill` für tabellen- und paragraphentreues Chunking + `text-embedding-3-large` (3072 dims).
      2. **Pre-Filtered Hybrid Search (`table_vector_index`):** Filtert strikt auf `avbVersionId` und kombiniert BM25 (exakte Paragraphen/Tarifcodes) mit HNSW-Vektorsuche.
      3. **RRF & L2 Semantic Reranker (`semantic_reranker`):** Fusioniert Top-50 Treffer per Reciprocal Rank Fusion und bewertet sie mit dem Cross-Encoder (`@search.rerankerScore >= 2.2`) inkl. Extractive Captions.
      4. **RAG-Evaluation (`eval_engine`):** Prüft kontinuierlich Context Relevance, NDCG@3 und Groundedness gegen die abgerufenen Chunks.
    '''

    include
      azure_vnet.rule_authoring_subsystem.avb_intake,
      azure_vnet.data_stores.vector_search,
      azure_vnet.data_stores.vector_search.*,
      azure_vnet.multi_agent_system.coverage_agent.tool_search_clauses,
      azure_vnet.multi_agent_system.adjudication_agent.tool_map_items,
      azure_vnet.multi_agent_system.customer_agent.tool_gen_eob,
      azure_vnet.langfuse.eval_engine

    autoLayout LeftRight
  }

