#section-title("3. Workflow 2: Multi-Agenten-System für die Schadenprüfung")

#block(
  width: 100%,
  stroke: 0.6pt + rgb("#cbd5e1"),
  radius: 3pt,
  inset: 4pt,
  fill: white,
  [
    #image("../diagrams/multi-agent-system.svg", width: 100%)
  ]
